+// isTrashedModel checks whether this particular delete moved the record into
+// the trash rather than removing its row.
+//
+// A record loaded out of the trash and then purged is not a transition, so its
+// files must still be cleaned up.
+// isTrashedModel reports whether the delete that just ran moved the model to
+// the trash rather than removing it.
+//
+// A proxy is unwrapped the same way the neighbouring file support check does
+// it: the delete hooks run against the proxied record and mark that one, so a
+// proxy left unexamined would look like a permanent delete and cost the record
+// its files.
+func isTrashedModel(m Model) bool {
+	switch v := m.(type) {
+	case *Record:
+		return v.trashTransition
+	case RecordProxy:
+		return v.ProxyRecord() != nil && v.ProxyRecord().trashTransition
+	}
+
+	return false
+}
