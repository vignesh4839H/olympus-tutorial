+// isRestoredRecord checks whether the just saved model is a record that was
+// brought back from the trash.
+//
+// It keys off the save operation rather than the record's original data, which
+// is not refreshed after a save and would otherwise keep reporting every later
+// update of the same instance as a restore.
+func isRestoredRecord(ctx context.Context, m core.Model) bool {
+	record, ok := m.(*core.Record)
+	if !ok || !record.Collection().IsSoftDeleteEnabled() {
+		return false
+	}
+
+	return core.IsRestoreOperation(ctx)
