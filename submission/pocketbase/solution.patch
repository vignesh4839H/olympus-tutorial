+
+// recordsPurgeTrash permanently deletes the trashed records of the collection.
+//
+// It accepts an optional "before" datetime query parameter to keep the records
+// that were trashed after it.
+//
+// Emptying the trash is a bulk irreversible operation, so unlike the single
+// record purge it is restricted to superusers.
+func recordsPurgeTrash(e *core.RequestEvent) error {
+	collection, err := e.App.FindCachedCollectionByNameOrId(e.Request.PathValue("collection"))
+	if err != nil || collection == nil {
+		return e.NotFoundError("Missing collection context.", err)
+	}
+
+	if !collection.IsSoftDeleteEnabled() {
+		return e.BadRequestError("The collection doesn't have the soft delete mode enabled.", nil)
+	}
+
+	requestInfo, err := e.RequestInfo()
+	if err != nil {
+		return firstApiError(err, e.BadRequestError("", err))
+	}
+
+	if !requestInfo.HasSuperuserAuth() {
+		return e.ForbiddenError("Only superusers can perform this action.", nil)
+	}
+
+	// the zero value purges the entire trash
+	var before types.DateTime
+
+	if raw := e.Request.URL.Query().Get("before"); raw != "" {
+		parsed, parseErr := types.ParseDateTime(raw)
+		if parseErr != nil || parsed.IsZero() {
+			return e.BadRequestError(`Invalid "before" query parameter value - must be a valid datetime.`, parseErr)
+		}
+
+		before = parsed
+	}
+
+	purged, err := e.App.PurgeTrashedRecords(collection, before)
+	if err != nil {
+		return firstApiError(err, e.BadRequestError("Failed to purge the collection trash.", err))
+	}
+
+	return execAfterSuccessTx(true, e.App, func() error {
+		return e.JSON(http.StatusOK, map[string]any{"purged": purged})
+	})
+}
+
+// Supported values of the "trashed" records query parameter.
+const (
+	trashedModeNone = ""     // only the live records (default)
+	trashedModeWith = "with" // both the live and the trashed records
+	trashedModeOnly = "only" // only the trashed records
+)
+
+// resolveTrashedMode reads and validates the "trashed" query parameter.
+//
+// The parameter is accepted but has no effect for collections without the
+// soft delete mode enabled so that they keep behaving exactly as before.
+func resolveTrashedMode(e *core.RequestEvent, collection *core.Collection) (string, error) {
+	mode := e.Request.URL.Query().Get("trashed")
+
+	switch mode {
+	case trashedModeNone, trashedModeWith, trashedModeOnly:
+		// supported
+	default:
+		return "", e.BadRequestError(`Invalid "trashed" query parameter value - must be "with" or "only".`, nil)
+	}
+
+	if !collection.IsSoftDeleteEnabled() {
+		return trashedModeNone, nil
+	}
+
+	return mode, nil
+}
+
+// resolvePurgeParam reads and validates the "purge" delete query parameter.
+func resolvePurgeParam(e *core.RequestEvent) (bool, error) {
+	raw := e.Request.URL.Query().Get("purge")
+	if raw == "" {
+		return false, nil
+	}
+
+	purge, err := strconv.ParseBool(raw)
+	if err != nil {
+		return false, e.BadRequestError(`Invalid "purge" query parameter value - must be a boolean.`, err)
+	}
+
+	return purge, nil
+}
