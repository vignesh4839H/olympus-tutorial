+			idColumn := refTableName + ".id"
+
+			err := eachReferencingRecordId(
+				idColumn,
+				func(cursor string) *dbx.SelectQuery {
+					return referencingRecordIdsQuery(app, mainRecord, refCollection, field).
+						AndWhere(dbx.HashExp{refTableName + "." + FieldNameDeleted: trashedAt.String()}).
+						AndWhere(dbx.NewExp("[["+idColumn+"]] > {:cursor}", dbx.Params{"cursor": cursor}))
+				},
+				func(refId string) error {
+					refRecord, err := app.FindTrashedRecordById(refCollection, refId)
+					if err != nil {
+						if errors.Is(err, sql.ErrNoRows) {
+							return nil
+						}
+						return err
+					}
+
+					return app.RestoreRecord(refRecord)
+				},
+			)
+			if err != nil {
+				return err
+			}
+		}
+	}
+
+	return nil
+}
+
+// checkTrashedRecordUpdate ensures that a record sitting in the trash is not
+// modified by anything other than a restore.
+//
+// The decision is made from the operation, not from the submitted value:
+// letting any save that happens to clear the trash stamp through would turn
+// an ordinary update into a second, unchecked restore path.
+func checkTrashedRecordUpdate(ctx context.Context, record *Record) error {
+	if record.IsNew() || !record.Collection().IsSoftDeleteEnabled() {
+		return nil
+	}
+
+	if record.Original().GetDateTime(FieldNameDeleted).IsZero() {
+		return nil // the persisted record is not trashed
+	}
+
+	if IsRestoreOperation(ctx) {
+		return nil
+	}
+
+	return validation.Errors{
+		FieldNameDeleted: validation.NewError(
+			"validation_trashed_record_update",
+			"Trashed records cannot be updated. Restore the record first.",
+		),
+	}
+}
+
+// checkRestorableRelations ensures that the record is not brought back while a
+// record it cascade-depends on is still in the trash.
+//
+// Without the check a restore could leave a visible record pointing to an
+// invisible one, which is exactly the state the cascade trash avoids.
+func checkRestorableRelations(app App, record *Record) error {
+	errs := validation.Errors{}
+
+	for _, field := range record.Collection().Fields {
+		relField, ok := field.(*RelationField)
+		if !ok || !relField.CascadeDelete {
+			continue
+		}
+
+		relCollection, err := app.FindCachedCollectionByNameOrId(relField.CollectionId)
+		if err != nil || relCollection == nil || !relCollection.IsSoftDeleteEnabled() {
+			continue
+		}
+
+		for _, relId := range record.GetStringSlice(relField.Name) {
+			_, err := app.FindRecordById(relCollection, relId)
+			if err == nil {
+				continue // the related record is visible
+			}
+
+			if !errors.Is(err, sql.ErrNoRows) {
+				return err
+			}
+
+			errs[relField.Name] = validation.NewError(
+				"validation_trashed_relation",
+				"The record cannot be restored while the related "+relCollection.Name+" record is still in the trash.",
+			)
+
+			break
+		}
+	}
+
+	if len(errs) > 0 {
+		return errs
+	}
+
+	return nil
+}
+
+// RestoreRecord moves the provided trashed record out of the trash.
+//
+// It is a no-op if the record is not currently trashed.
+func (app *BaseApp) RestoreRecord(record *Record) error {
+	return app.RestoreRecordWithContext(context.Background(), record)
+}
+
+// RestoreRecordWithContext is the same as [App.RestoreRecord] but allows
+// specifying a context to limit the db execution.
+func (app *BaseApp) RestoreRecordWithContext(ctx context.Context, record *Record) error {
+	if !record.Collection().IsSoftDeleteEnabled() {
+		return errors.New("the " + record.Collection().Name + " collection doesn't have the soft delete mode enabled")
+	}
+
+	if record.IsNew() {
+		return errors.New("only existing records can be restored")
+	}
+
+	if !record.IsTrashed() {
+		return nil
+	}
+
+	if err := checkRestorableRelations(app, record); err != nil {
+		return err
+	}
+
+	trashedAt := record.TrashedAt()
+
+	refs, err := app.FindCachedCollectionReferences(record.Collection())
+	if err != nil {
+		return err
+	}
+
+	restoreCtx := withRestoreContext(ctx)
+
+	err = app.RunInTransaction(func(txApp App) error {
+		record.Set(FieldNameDeleted, "")
+
+		if err := txApp.SaveWithContext(restoreCtx, record); err != nil {
+			return err
+		}
+
+		return restoreCascadedRecords(txApp, record, refs, trashedAt)
+	})
+	if err != nil {
+		// put the in-memory model back where it was so a failed restore
+		// doesn't leave the caller holding a record that looks live
+		record.SetRaw(FieldNameDeleted, trashedAt)
+
+		return err
+	}
+
+	// the row is live now, so the guard on further saves has to see that too
+	record.originalData[FieldNameDeleted] = types.DateTime{}
+
+	return nil
+}
+
+// PurgeRecord permanently deletes the provided record, skipping the trash
+// even if the record collection has the soft delete mode enabled.
+//
+// The regular record delete hooks and the cascade delete of the referencing
+// records are still executed.
+func (app *BaseApp) PurgeRecord(record *Record) error {
+	return app.PurgeRecordWithContext(context.Background(), record)
+}
+
+// PurgeRecordWithContext is the same as [App.PurgeRecord] but allows
+// specifying a context to limit the db execution.
+func (app *BaseApp) PurgeRecordWithContext(ctx context.Context, record *Record) error {
+	return app.DeleteWithContext(withPurgeContext(ctx), record)
+}
+
+// PurgeTrashedRecords permanently deletes all trashed records of the provided
+// collection that were moved to the trash before the specified time.
+//
+// A zero "before" value purges the entire collection trash.
+//
+// It returns the total number of purged records.
+func (app *BaseApp) PurgeTrashedRecords(collectionModelOrIdentifier any, before types.DateTime) (int, error) {
+	collection, err := getCollectionByModelOrIdentifier(app, collectionModelOrIdentifier)
+	if err != nil {
+		return 0, err
+	}
+
+	if !collection.IsSoftDeleteEnabled() {
+		return 0, errors.New("the " + collection.Name + " collection doesn't have the soft delete mode enabled")
+	}
+
+	var cutoff dbx.Expression
+	if !before.IsZero() {
+		cutoff = dbx.NewExp(
+			"[["+collection.Name+"."+FieldNameDeleted+"]] < {:before}",
+			dbx.Params{"before": before.String()},
+		)
+	}
+
+	records, err := app.FindAllTrashedRecords(collection, cutoff)
+	if err != nil {
+		return 0, err
+	}
+
+	var purged int
+
+	for _, record := range records {
+		if err := app.PurgeRecord(record); err != nil {
+			return purged, err
+		}
+
+		purged++
+	}
+
+	return purged, nil
+}
+
+// PurgeExpiredTrashedRecords permanently deletes the trashed records that
+// stayed in the trash for longer than the retention period configured for
+// their collection.
+//
+// Collections without the soft delete mode or with a non-positive
+// trashRetention are skipped.
+func (app *BaseApp) PurgeExpiredTrashedRecords() error {
+	collections, err := app.FindAllCollections(CollectionTypeBase)
+	if err != nil {
+		return err
+	}
+
+	var errs []error
+
+	for _, collection := range collections {
+		if !collection.IsSoftDeleteEnabled() || collection.TrashRetention <= 0 {
+			continue
+		}
+
+		before := types.NowDateTime().Add(-1 * time.Duration(collection.TrashRetention) * time.Second)
+
+		_, purgeErr := app.PurgeTrashedRecords(collection, before)
+		if purgeErr != nil {
+			errs = append(errs, fmt.Errorf("failed to purge the expired %s trashed records: %w", collection.Name, purgeErr))
+		}
+	}
+
+	return errors.Join(errs...)
+}
