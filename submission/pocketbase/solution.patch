new file mode 100644
index 0000000..551829a
--- /dev/null
+++ b/core/record_trash.go
@@ -0,0 +1,612 @@
+package core
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"fmt"
+	"sync"
+	"time"
+
+	"github.com/pocketbase/dbx"
+	validation "github.com/pocketbase/ozzo-validation/v4"
+	"github.com/pocketbase/pocketbase/tools/inflector"
+	"github.com/pocketbase/pocketbase/tools/types"
+)
+
+// purgeContextKey is the context key used to mark a delete operation as a
+// permanent removal, so that it is not intercepted by the soft delete mode.
+type purgeContextKey struct{}
+
+// withPurgeContext returns a copy of ctx marked as a permanent delete.
+func withPurgeContext(ctx context.Context) context.Context {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+
+	return context.WithValue(ctx, purgeContextKey{}, true)
+}
+
+// isPurgeContext checks whether ctx was marked as a permanent delete.
+func isPurgeContext(ctx context.Context) bool {
+	if ctx == nil {
+		return false
+	}
+
+	enabled, _ := ctx.Value(purgeContextKey{}).(bool)
+
+	return enabled
+}
+
+var (
+	trashTimestampMu   sync.Mutex
+	lastTrashTimestamp types.DateTime
+)
+
+// nextTrashTimestamp returns the timestamp to stamp the next delete with.
+//
+// The trash timestamp is what ties together the records trashed by a single
+// delete, but it is stored with a millisecond precision, so two unrelated
+// deletes could otherwise end up sharing one and a restore could bring back
+// records that have nothing to do with the restored one.
+//
+// To avoid that, the returned value is always strictly greater than the one
+// returned by the previous call.
+func nextTrashTimestamp() types.DateTime {
+	trashTimestampMu.Lock()
+	defer trashTimestampMu.Unlock()
+
+	// the value is stored with a millisecond precision, so the sub-millisecond
+	// part has to be dropped before comparing it with the previous one
+	now, _ := types.ParseDateTime(time.Now().UTC().Truncate(time.Millisecond))
+
+	if !now.After(lastTrashTimestamp) {
+		now = lastTrashTimestamp.Add(1 * time.Millisecond)
+	}
+
+	lastTrashTimestamp = now
+
+	return now
+}
+
+// restoreContextKey marks the single save performed by RestoreRecord, so that
+// clearing the trash stamp cannot be done through an ordinary save.
+type restoreContextKey struct{}
+
+// withRestoreContext returns a copy of ctx marked as a restore.
+func withRestoreContext(ctx context.Context) context.Context {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+
+	return context.WithValue(ctx, restoreContextKey{}, true)
+}
+
+// IsRestoreOperation reports whether ctx belongs to a record restore.
+//
+// It is true only for the save issued by [App.RestoreRecord], so callers can
+// tell a record coming back from the trash from any later update of it.
+func IsRestoreOperation(ctx context.Context) bool {
+	if ctx == nil {
+		return false
+	}
+
+	enabled, _ := ctx.Value(restoreContextKey{}).(bool)
+
+	return enabled
+}
+
+// trashTimestampContextKey is the context key carrying the trash timestamp
+// shared by all the records moved to the trash as part of a single delete.
+type trashTimestampContextKey struct{}
+
+// withTrashTimestamp returns a copy of ctx carrying the provided trash timestamp.
+func withTrashTimestamp(ctx context.Context, trashedAt types.DateTime) context.Context {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+
+	return context.WithValue(ctx, trashTimestampContextKey{}, trashedAt)
+}
+
+// trashTimestampFromContext returns the trash timestamp carried by ctx, if any.
+func trashTimestampFromContext(ctx context.Context) (types.DateTime, bool) {
+	if ctx == nil {
+		return types.DateTime{}, false
+	}
+
+	trashedAt, ok := ctx.Value(trashTimestampContextKey{}).(types.DateTime)
+
+	return trashedAt, ok
+}
+
+// IsTrashed checks whether the record is currently in the trash.
+//
+// It always returns false for collections that don't have the soft delete
+// mode enabled.
+func (m *Record) IsTrashed() bool {
+	return !m.TrashedAt().IsZero()
+}
+
+// TrashedAt returns the time at which the record was moved to the trash.
+//
+// The zero [types.DateTime] is returned for records that are not trashed or
+// that belong to a collection without the soft delete mode enabled.
+func (m *Record) TrashedAt() types.DateTime {
+	if m.collection == nil || !m.collection.IsSoftDeleteEnabled() {
+		return types.DateTime{}
+	}
+
+	return m.GetDateTime(FieldNameDeleted)
+}
+
+// notTrashedExpr returns the expression matching only the records of the
+// provided collection that are NOT in the trash.
+func notTrashedExpr(collection *Collection) dbx.Expression {
+	return dbx.HashExp{collection.Name + "." + FieldNameDeleted: ""}
+}
+
+// trashedExpr returns the expression matching only the records of the
+// provided collection that ARE in the trash.
+func trashedExpr(collection *Collection) dbx.Expression {
+	return dbx.Not(notTrashedExpr(collection))
+}
+
+// trashRecord moves the deleted record to the trash together with the records
+// that reference it through a "cascade delete" relation.
+//
+// NB! It is expected to be called only for collections with the soft delete
+// mode enabled and from within the record delete execute hook.
+func trashRecord(e *RecordEvent) error {
+	// note: the select is outside of the transaction to minimize
+	// SQLITE_BUSY errors when mixing read&write in a single transaction
+	refs, err := e.App.FindCachedCollectionReferences(e.Record.Collection())
+	if err != nil {
+		return err
+	}
+
+	// every record trashed as part of this delete shares the same timestamp
+	// so that a later restore can bring back exactly the same group
+	trashedAt, ok := trashTimestampFromContext(e.Context)
+	if !ok {
+		trashedAt = nextTrashTimestamp()
+	}
+
+	ctx := withTrashTimestamp(e.Context, trashedAt)
+
+	originalApp := e.App
+	txErr := e.App.RunInTransaction(func(txApp App) error {
+		e.App = txApp
+
+		if err := trashRecordExecute(e, trashedAt); err != nil {
+			return err
+		}
+
+		return cascadeRecordTrash(txApp, ctx, e.Record, refs)
+	})
+	e.App = originalApp
+
+	return txErr
+}
+
+// trashRecordExecute stamps the trash timestamp of the deleted record
+// instead of removing its row.
+func trashRecordExecute(e *RecordEvent, trashedAt types.DateTime) error {
+	collection := e.Record.Collection()
+
+	pk := e.Record.LastSavedPK()
+	if pk == "" {
+		return errors.New("the record can be trashed only if it is existing and has a non-empty primary key")
+	}
+
+	err := baseLockRetry(func(attempt int) error {
+		_, execErr := e.App.NonconcurrentDB().Update(
+			collection.Name,
+			dbx.Params{FieldNameDeleted: trashedAt.String()},
+			dbx.HashExp{idColumn: pk},
+		).WithContext(e.Context).Execute()
+
+		return execErr
+	}, defaultMaxLockRetries)
+	if err != nil {
+		return err
+	}
+
+	// reflect the new state in the in-memory model so that the after-delete
+	// hooks (and the caller) can tell a trashed record from a removed one
+	e.Record.SetRaw(FieldNameDeleted, trashedAt)
+	e.Record.originalData[FieldNameDeleted] = trashedAt
+	e.Record.trashTransition = true
+
+	return nil
+}
+
+// trashCascadeBatchSize is the number of referencing record ids loaded at once
+// by the trash and restore cascades.
+const trashCascadeBatchSize = 500
+
+// eachReferencingRecordId walks the ids of the records referencing the main
+// record and invokes the callback for each of them.
+//
+// The rows are paged with an id cursor rather than an offset because the
+// callback modifies the very rows the query matches, which would otherwise
+// either skip rows or loop forever.
+func eachReferencingRecordId(
+	idColumn string,
+	build func(cursor string) *dbx.SelectQuery,
+	callback func(refId string) error,
+) error {
+	var cursor string
+
+	for {
+		var refIds []string
+
+		err := build(cursor).
+			OrderBy(idColumn).
+			Limit(trashCascadeBatchSize).
+			Column(&refIds)
+		if err != nil {
+			return err
+		}
+
+		total := len(refIds)
+		if total == 0 {
+			return nil
+		}
+
+		for _, refId := range refIds {
+			if err := callback(refId); err != nil {
+				return err
+			}
+		}
+
+		if total < trashCascadeBatchSize {
+			return nil
+		}
+
+		cursor = refIds[total-1]
+	}
+}
+
+// cascadeRecordTrash moves to the trash the records that reference the just
+// trashed record through a "cascade delete" relation.
+//
+// Unlike the permanent delete cascade, the relation values are left untouched
+// because the trashed record is still there and could be restored later.
+//
+// NB! This method is expected to be called from inside of a transaction.
+func cascadeRecordTrash(app App, ctx context.Context, mainRecord *Record, refs map[*Collection][]Field) error {
+	for _, refCollection := range sortedRefCollections(refs) {
+		if refCollection.IsView() {
+			continue
+		}
+
+		for _, field := range refs[refCollection] {
+			relField, ok := field.(*RelationField)
+			if !ok || !relField.CascadeDelete {
+				continue // only the cascade delete relations follow the main record
+			}
+
+			idColumn := inflector.Columnify(refCollection.Name) + ".id"
+
+			err := eachReferencingRecordId(
+				idColumn,
+				func(cursor string) *dbx.SelectQuery {
+					return referencingRecordIdsQuery(app, mainRecord, refCollection, field).
+						AndWhere(dbx.NewExp("[["+idColumn+"]] > {:cursor}", dbx.Params{"cursor": cursor}))
+				},
+				func(refId string) error {
+					// note: the already trashed records are skipped, which also
+					// breaks the eventual reference cycles
+					refRecord, err := app.FindRecordById(refCollection, refId)
+					if err != nil {
+						if errors.Is(err, sql.ErrNoRows) {
+							return nil
+						}
+						return err
+					}
+
+					// for a multi-value relation the referencing record follows the
+					// main one only if the trashed record is the last live record
+					// it still points at
+					if hasOtherLiveReference(app, mainRecord, refRecord, relField) {
+						return nil
+					}
+
+					return app.DeleteWithContext(ctx, refRecord)
+				},
+			)
+			if err != nil {
+				return err
+			}
+		}
+	}
+
+	return nil
+}
+
+// hasOtherLiveReference checks whether the referencing record still points at
+// a visible record other than the one that is being trashed.
+//
+// The relation values are left alone by the trash, so the ids alone cannot
+// tell whether anything is still keeping the referencing record alive.
+func hasOtherLiveReference(app App, mainRecord *Record, refRecord *Record, relField *RelationField) bool {
+	for _, id := range refRecord.GetStringSlice(relField.Name) {
+		if id == mainRecord.Id {
+			continue
+		}
+
+		if _, err := app.FindRecordById(mainRecord.Collection(), id); err == nil {
+			return true
+		}
+	}
+
+	return false
+}
+
+// restoreCascadedRecords brings back the records that were moved to the trash
+// together with the record that is being restored.
+//
+// Only the records sharing the exact trash timestamp of the main record are
+// restored, so the ones that were trashed on their own stay in the trash.
+//
+// NB! This method is expected to be called from inside of a transaction.
+func restoreCascadedRecords(app App, mainRecord *Record, refs map[*Collection][]Field, trashedAt types.DateTime) error {
+	for _, refCollection := range sortedRefCollections(refs) {
+		if refCollection.IsView() || !refCollection.IsSoftDeleteEnabled() {
+			continue
+		}
+
+		for _, field := range refs[refCollection] {
+			relField, ok := field.(*RelationField)
+			if !ok || !relField.CascadeDelete {
+				continue
+			}
+
+			refTableName := inflector.Columnify(refCollection.Name)
+			idColumn := refTableName + ".id"
+
+			err := eachReferencingRecordId(
+				idColumn,
+				func(cursor string) *dbx.SelectQuery {
+					return referencingRecordIdsQuery(app, mainRecord, refCollection, field).
+						AndWhere(dbx.HashExp{refTableName + "." + FieldNameDeleted: trashedAt.String()}).
+						AndWhere(dbx.NewExp("[["+idColumn+"]] > {:cursor}", dbx.Params{"cursor": cursor}))
+				},
+				func(refId string) error {
+					refRecord, err := app.FindTrashedRecordById(refCollection, refId)
+					if err != nil {
+						if errors.Is(err, sql.ErrNoRows) {
+							return nil
+						}
+						return err
+					}
+
+					return app.RestoreRecord(refRecord)
+				},
+			)
+			if err != nil {
+				return err
+			}
+		}
+	}
+
+	return nil
+}
+
+// checkTrashedRecordUpdate ensures that a record sitting in the trash is not
+// modified by anything other than a restore.
+//
+// The decision is made from the operation, not from the submitted value:
+// letting any save that happens to clear the trash stamp through would turn
+// an ordinary update into a second, unchecked restore path.
+func checkTrashedRecordUpdate(ctx context.Context, record *Record) error {
+	if record.IsNew() || !record.Collection().IsSoftDeleteEnabled() {
+		return nil
+	}
+
+	if record.Original().GetDateTime(FieldNameDeleted).IsZero() {
+		return nil // the persisted record is not trashed
+	}
+
+	if IsRestoreOperation(ctx) {
+		return nil
+	}
+
+	return validation.Errors{
+		FieldNameDeleted: validation.NewError(
+			"validation_trashed_record_update",
+			"Trashed records cannot be updated. Restore the record first.",
+		),
+	}
+}
+
+// checkRestorableRelations ensures that the record is not brought back while a
+// record it cascade-depends on is still in the trash.
+//
+// Without the check a restore could leave a visible record pointing to an
+// invisible one, which is exactly the state the cascade trash avoids.
+func checkRestorableRelations(app App, record *Record) error {
+	errs := validation.Errors{}
+
+	for _, field := range record.Collection().Fields {
+		relField, ok := field.(*RelationField)
+		if !ok || !relField.CascadeDelete {
+			continue
+		}
+
+		relCollection, err := app.FindCachedCollectionByNameOrId(relField.CollectionId)
+		if err != nil || relCollection == nil || !relCollection.IsSoftDeleteEnabled() {
+			continue
+		}
+
+		for _, relId := range record.GetStringSlice(relField.Name) {
+			_, err := app.FindRecordById(relCollection, relId)
+			if err == nil {
+				continue // the related record is visible
+			}
+
+			if !errors.Is(err, sql.ErrNoRows) {
+				return err
+			}
+
+			errs[relField.Name] = validation.NewError(
+				"validation_trashed_relation",
+				"The record cannot be restored while the related "+relCollection.Name+" record is still in the trash.",
+			)
+
+			break
+		}
+	}
+
+	if len(errs) > 0 {
+		return errs
+	}
+
+	return nil
+}
+
+// RestoreRecord moves the provided trashed record out of the trash.
+//
+// It is a no-op if the record is not currently trashed.
+func (app *BaseApp) RestoreRecord(record *Record) error {
+	return app.RestoreRecordWithContext(context.Background(), record)
+}
+
+// RestoreRecordWithContext is the same as [App.RestoreRecord] but allows
+// specifying a context to limit the db execution.
+func (app *BaseApp) RestoreRecordWithContext(ctx context.Context, record *Record) error {
+	if !record.Collection().IsSoftDeleteEnabled() {
+		return errors.New("the " + record.Collection().Name + " collection doesn't have the soft delete mode enabled")
+	}
+
+	if record.IsNew() {
+		return errors.New("only existing records can be restored")
+	}
+
+	if !record.IsTrashed() {
+		return nil
+	}
+
+	if err := checkRestorableRelations(app, record); err != nil {
+		return err
+	}
+
+	trashedAt := record.TrashedAt()
+
+	refs, err := app.FindCachedCollectionReferences(record.Collection())
+	if err != nil {
+		return err
+	}
+
+	restoreCtx := withRestoreContext(ctx)
+
+	err = app.RunInTransaction(func(txApp App) error {
+		record.Set(FieldNameDeleted, "")
+
+		if err := txApp.SaveWithContext(restoreCtx, record); err != nil {
+			return err
+		}
+
+		return restoreCascadedRecords(txApp, record, refs, trashedAt)
+	})
+	if err != nil {
+		// put the in-memory model back where it was so a failed restore
+		// doesn't leave the caller holding a record that looks live
+		record.SetRaw(FieldNameDeleted, trashedAt)
+
+		return err
+	}
+
+	// the row is live now, so the guard on further saves has to see that too
+	record.originalData[FieldNameDeleted] = types.DateTime{}
+
+	return nil
+}
+
+// PurgeRecord permanently deletes the provided record, skipping the trash
+// even if the record collection has the soft delete mode enabled.
+//
+// The regular record delete hooks and the cascade delete of the referencing
+// records are still executed.
+func (app *BaseApp) PurgeRecord(record *Record) error {
+	return app.PurgeRecordWithContext(context.Background(), record)
+}
+
+// PurgeRecordWithContext is the same as [App.PurgeRecord] but allows
+// specifying a context to limit the db execution.
+func (app *BaseApp) PurgeRecordWithContext(ctx context.Context, record *Record) error {
+	return app.DeleteWithContext(withPurgeContext(ctx), record)
+}
+
+// PurgeTrashedRecords permanently deletes all trashed records of the provided
+// collection that were moved to the trash before the specified time.
+//
+// A zero "before" value purges the entire collection trash.
+//
+// It returns the total number of purged records.
+func (app *BaseApp) PurgeTrashedRecords(collectionModelOrIdentifier any, before types.DateTime) (int, error) {
+	collection, err := getCollectionByModelOrIdentifier(app, collectionModelOrIdentifier)
+	if err != nil {
+		return 0, err
+	}
+
+	if !collection.IsSoftDeleteEnabled() {
+		return 0, errors.New("the " + collection.Name + " collection doesn't have the soft delete mode enabled")
+	}
+
+	var cutoff dbx.Expression
+	if !before.IsZero() {
+		cutoff = dbx.NewExp(
+			"[["+collection.Name+"."+FieldNameDeleted+"]] < {:before}",
+			dbx.Params{"before": before.String()},
+		)
+	}
+
+	records, err := app.FindAllTrashedRecords(collection, cutoff)
+	if err != nil {
+		return 0, err
+	}
+
+	var purged int
+
+	for _, record := range records {
+		if err := app.PurgeRecord(record); err != nil {
+			return purged, err
+		}
+
+		purged++
+	}
+
+	return purged, nil
+}
+
+// PurgeExpiredTrashedRecords permanently deletes the trashed records that
+// stayed in the trash for longer than the retention period configured for
+// their collection.
+//
+// Collections without the soft delete mode or with a non-positive
+// trashRetention are skipped.
+func (app *BaseApp) PurgeExpiredTrashedRecords() error {
+	collections, err := app.FindAllCollections(CollectionTypeBase)
+	if err != nil {
+		return err
+	}
+
+	var errs []error
+
+	for _, collection := range collections {
+		if !collection.IsSoftDeleteEnabled() || collection.TrashRetention <= 0 {
+			continue
+		}
+
+		before := types.NowDateTime().Add(-1 * time.Duration(collection.TrashRetention) * time.Second)
+
+		_, purgeErr := app.PurgeTrashedRecords(collection, before)
+		if purgeErr != nil {
+			errs = append(errs, fmt.Errorf("failed to purge the expired %s trashed records: %w", collection.Name, purgeErr))
+		}
+	}
+
+	return errors.Join(errs...)
+}
