+func TestSoftDeleteTrashAccessorsOnLoadedRecords(t *testing.T) {
+	app, _ := tests.NewTestApp()
+	defer app.Cleanup()
+
+	posts, _, _ := sdSetup(t, app)
+
+	record := sdNewRecord(t, app, posts, map[string]any{"title": "accessors"})
+
+	live, err := app.FindRecordById(posts, record.Id)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if live.IsTrashed() || !live.TrashedAt().IsZero() {
+		t.Fatalf("expected a live record to report no trash time, got %q", live.TrashedAt().String())
+	}
+
+	if err := app.Delete(record); err != nil {
+		t.Fatal(err)
+	}
+
+	trashed, err := app.FindTrashedRecordById(posts, record.Id)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if !trashed.IsTrashed() || trashed.TrashedAt().IsZero() {
+		t.Fatal("expected a trashed record to report a trash time")
+	}
+
+	withTrashed, err := app.FindRecordByIdWithTrashed(posts, record.Id)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if withTrashed.TrashedAt().String() != trashed.TrashedAt().String() {
+		t.Fatalf(
+			"expected both trash-aware lookups to agree, got %q and %q",
+			withTrashed.TrashedAt().String(),
+			trashed.TrashedAt().String(),
+		)
+	}
+
+	if err := app.RestoreRecord(trashed); err != nil {
+		t.Fatal(err)
+	}
+
+	restored, err := app.FindRecordById(posts, record.Id)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if restored.IsTrashed() || !restored.TrashedAt().IsZero() {
+		t.Fatalf("expected a restored record to report no trash time, got %q", restored.TrashedAt().String())
+	}
+}
