+		t.Fatal(err)
+	}
+	if err := app.Delete(recent); err != nil {
+		t.Fatal(err)
+	}
+
+	// backdate the first record trash timestamp
+	oldTimestamp := types.NowDateTime().Add(-2 * time.Hour)
+	_, err := app.DB().Update(
+		posts.Name,
+		dbx.Params{core.FieldNameDeleted: oldTimestamp.String()},
+		dbx.HashExp{"id": old.Id},
+	).Execute()
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	purged, err := app.PurgeTrashedRecords(posts, types.NowDateTime().Add(-1*time.Hour))
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if purged != 1 {
+		t.Fatalf("expected 1 purged record, got %d", purged)
+	}
+
+	if sdRawExists(t, app, posts, old.Id) {
+		t.Fatal("expected the old record row to be removed")
+	}
+
+	if !sdRawExists(t, app, posts, recent.Id) {
+		t.Fatal("expected the recent record row to be kept")
+	}
+
+	if _, err := app.PurgeTrashedRecords(plain, types.NowDateTime()); err == nil {
+		t.Fatal("expected an error for a collection without the soft delete mode")
+	}
