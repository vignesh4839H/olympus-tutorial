+	comment := sdNewRecord(t, app, comments, map[string]any{"message": "child", "post": post.Id})
+
+	// the comment goes first and on its own, so it lands in its own group
+	if err := app.Delete(comment); err != nil {
+		t.Fatal(err)
+	}
+
+	// ... and the post follows separately
+	if err := app.Delete(post); err != nil {
+		t.Fatal(err)
+	}
