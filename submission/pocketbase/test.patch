+	if err != nil {
+		t.Fatal(err)
+	}
+
+	// the trashed comment points at the post, which must not hold it back
+	if err := app.RestoreRecord(trashedPost); err != nil {
+		t.Fatalf("expected a record pointing at the target not to block its restore, got %v", err)
+	}
+
+	if _, err := app.FindRecordById(posts, post.Id); err != nil {
+		t.Fatalf("expected the post to be live again, got %v", err)
+	}
+
+	if _, err := app.FindRecordById(comments, comment.Id); !errors.Is(err, sql.ErrNoRows) {
+		t.Fatalf("expected the separately trashed comment to stay in the trash, got %v", err)
+	}
