+func TestSoftDeleteTrashesInsteadOfRemoving(t *testing.T) {
+	app, _ := tests.NewTestApp()
+	defer app.Cleanup()
+
+	posts, _, plain := sdSetup(t, app)
+
+	record := sdNewRecord(t, app, posts, map[string]any{"title": "hello"})
+
+	if err := app.Delete(record); err != nil {
+		t.Fatal(err)
+	}
+
+	t.Run("the row is kept", func(t *testing.T) {
+		if !sdRawExists(t, app, posts, record.Id) {
+			t.Fatal("expected the record row to be kept")
+		}
+	})
+
+	t.Run("a loaded record answers the trash accessors", func(t *testing.T) {
+		// read back rather than inspecting the object handed to Delete: the
+		// contract is about the record's state, not about the caller's pointer
+		loaded, err := app.FindRecordByIdWithTrashed(posts, record.Id)
+		if err != nil {
+			t.Fatal(err)
+		}
+
+		if !loaded.IsTrashed() {
+			t.Fatal("expected the loaded record to report itself as trashed")
+		}
+
+		if loaded.TrashedAt().IsZero() {
+			t.Fatal("expected a non-zero trash timestamp")
+		}
+	})
+
+	t.Run("the record is no longer found", func(t *testing.T) {
+		_, err := app.FindRecordById(posts, record.Id)
+		if !errors.Is(err, sql.ErrNoRows) {
+			t.Fatalf("expected sql.ErrNoRows, got %v", err)
+		}
+	})
+
+	t.Run("the record is found with the trashed ones", func(t *testing.T) {
+		found, err := app.FindRecordByIdWithTrashed(posts, record.Id)
+		if err != nil {
+			t.Fatal(err)
+		}
+
+		if found.Id != record.Id {
+			t.Fatalf("expected %q, got %q", record.Id, found.Id)
+		}
+
+		if !found.IsTrashed() {
+			t.Fatal("expected the loaded record to be trashed")
+		}
+	})
+
+	t.Run("the record is found by the trashed only lookup", func(t *testing.T) {
+		found, err := app.FindTrashedRecordById(posts, record.Id)
+		if err != nil {
+			t.Fatal(err)
+		}
+
+		if found.Id != record.Id {
+			t.Fatalf("expected %q, got %q", record.Id, found.Id)
+		}
+	})
+
+	t.Run("listings hide the trashed record", func(t *testing.T) {
+		live, err := app.FindAllRecords(posts)
+		if err != nil {
+			t.Fatal(err)
+		}
+
+		if len(live) != 0 {
+			t.Fatalf("expected no live records, got %v", sdFindIds(t, live))
+		}
+
+		trashed, err := app.FindAllTrashedRecords(posts)
+		if err != nil {
+			t.Fatal(err)
+		}
+
+		if len(trashed) != 1 || trashed[0].Id != record.Id {
+			t.Fatalf("expected only %q, got %v", record.Id, sdFindIds(t, trashed))
+		}
+	})
+
+	t.Run("counting hides the trashed record", func(t *testing.T) {
+		total, err := app.CountRecords(posts)
+		if err != nil {
+			t.Fatal(err)
+		}
+
+		if total != 0 {
+			t.Fatalf("expected 0 records, got %d", total)
+		}
+	})
+
+	t.Run("regular collections still remove the row", func(t *testing.T) {
+		other := sdNewRecord(t, app, plain, map[string]any{"title": "plain"})
+
+		if err := app.Delete(other); err != nil {
+			t.Fatal(err)
+		}
+
+		if sdRawExists(t, app, plain, other.Id) {
+			t.Fatal("expected the record row to be removed")
+		}
+	})
+}
