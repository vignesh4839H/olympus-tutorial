+func TestSoftDeletePurgeTrashedRecordsCutoffIsStrict(t *testing.T) {
+	app, _ := tests.NewTestApp()
+	defer app.Cleanup()
+
+	posts, _, _ := sdSetup(t, app)
+
+	atCutoff := sdNewRecord(t, app, posts, map[string]any{"title": "exactly at the cutoff"})
+	before := sdNewRecord(t, app, posts, map[string]any{"title": "a moment earlier"})
+
+	for _, record := range []*core.Record{atCutoff, before} {
+		if err := app.Delete(record); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	cutoff := types.NowDateTime().Add(-1 * time.Hour)
+
+	stamp := func(record *core.Record, at types.DateTime) {
+		t.Helper()
+
+		_, err := app.DB().Update(
+			posts.Name,
+			dbx.Params{core.FieldNameDeleted: at.String()},
+			dbx.HashExp{"id": record.Id},
+		).Execute()
+		if err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	stamp(atCutoff, cutoff)
+	stamp(before, cutoff.Add(-1*time.Minute))
+
+	purged, err := app.PurgeTrashedRecords(posts, cutoff)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if purged != 1 {
+		t.Fatalf("expected only the earlier record to go, got %d", purged)
+	}
+
+	if sdRawExists(t, app, posts, before.Id) {
+		t.Fatal("expected the record trashed before the cutoff to be removed")
+	}
+
+	if !sdRawExists(t, app, posts, atCutoff.Id) {
+		t.Fatal("expected the record trashed exactly at the cutoff to be kept")
+	}
+}
