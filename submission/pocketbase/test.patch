+func TestSoftDeleteRestoreRequiresLiveCascadeParent(t *testing.T) {
+	app, _ := tests.NewTestApp()
+	defer app.Cleanup()
+
+	posts, comments, _ := sdSetup(t, app)
+
+	post := sdNewRecord(t, app, posts, map[string]any{"title": "parent"})
+	comment := sdNewRecord(t, app, comments, map[string]any{"message": "child", "post": post.Id})
+
+	// the cascade puts both records in the same group, so the restore may
+	// start from either of them
+	if err := app.Delete(post); err != nil {
+		t.Fatal(err)
+	}
+
+	trashedComment, err := app.FindTrashedRecordById(comments, comment.Id)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if err := app.RestoreRecord(trashedComment); err != nil {
+		t.Fatalf("expected the group to be restorable from the cascade child, got %v", err)
+	}
+
+	if _, err := app.FindRecordById(posts, post.Id); err != nil {
+		t.Fatalf("expected the post to be restored with its comment, got %v", err)
+	}
+
+	if _, err := app.FindRecordById(comments, comment.Id); err != nil {
+		t.Fatalf("expected the comment to be restored, got %v", err)
+	}
+
+	// a parent trashed on its own carries a different timestamp, so it stays
+	// outside of the comment's group and blocks its restore
+	liveComment, err := app.FindRecordById(comments, comment.Id)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if err := app.Delete(liveComment); err != nil {
+		t.Fatal(err)
+	}
+
+	livePost, err := app.FindRecordById(posts, post.Id)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if err := app.Delete(livePost); err != nil {
+		t.Fatal(err)
+	}
+
+	trashedComment, err = app.FindTrashedRecordById(comments, comment.Id)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	trashedPost, err := app.FindTrashedRecordById(posts, post.Id)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if trashedComment.TrashedAt().String() == trashedPost.TrashedAt().String() {
+		t.Fatal("expected the separate deletes to produce different trash timestamps")
+	}
+
+	if err := app.RestoreRecord(trashedComment); err == nil {
+		t.Fatal("expected an error when restoring a record whose external cascade parent is still trashed")
+	}
+
+	if err := app.RestoreRecord(trashedPost); err != nil {
+		t.Fatal(err)
+	}
+
+	trashedComment, err = app.FindTrashedRecordById(comments, comment.Id)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if err := app.RestoreRecord(trashedComment); err != nil {
+		t.Fatalf("expected the comment to be restorable once its parent is live, got %v", err)
+	}
+}
