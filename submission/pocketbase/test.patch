+		MaxSelect:    5,
+	})
+	if err := app.Save(comments); err != nil {
+		t.Fatal(err)
+	}
+
+	first := sdNewRecord(t, app, posts, map[string]any{"title": "first"})
+	second := sdNewRecord(t, app, posts, map[string]any{"title": "second"})
+	comment := sdNewRecord(t, app, comments, map[string]any{
+		"message": "hi",
+		"targets": []string{first.Id, second.Id},
+	})
+
+	assertMatches := func(label string, filter string, expected int) {
+		t.Helper()
+
+		records, err := app.FindRecordsByFilter(comments, filter, "", 0, 0)
+		if err != nil {
+			t.Fatalf("%s: %v", label, err)
+		}
+
+		if len(records) != expected {
+			t.Fatalf("%s: expected %d match(es), got %v", label, expected, sdFindIds(t, records))
+		}
+
+		if expected > 0 && records[0].Id != comment.Id {
+			t.Fatalf("%s: expected %q, got %v", label, comment.Id, sdFindIds(t, records))
+		}
+	}
+
+	assertMatches("bare before", "targets ?= '"+first.Id+"'", 1)
+	assertMatches("each before", "targets:each ?= '"+first.Id+"'", 1)
+	assertMatches("length before", "targets:length = 2", 1)
+
+	if err := app.Delete(first); err != nil {
+		t.Fatal(err)
+	}
+
+	assertMatches("bare after", "targets ?= '"+first.Id+"'", 0)
+	assertMatches("each after", "targets:each ?= '"+first.Id+"'", 0)
+
+	// the trashed target must not be counted anymore
+	assertMatches("stale length after", "targets:length = 2", 0)
+	assertMatches("length after", "targets:length = 1", 1)
+
+	// the still live target keeps matching
+	assertMatches("live sibling", "targets ?= '"+second.Id+"'", 1)
+}
diff --git a/scripts/junitreport/main.go b/scripts/junitreport/main.go
new file mode 100644
index 0000000..4f7ac2f
--- /dev/null
+++ b/scripts/junitreport/main.go
@@ -0,0 +1,238 @@
+// Command junitreport turns the output of "go test -json" into a JUnit XML
+// report. The test output is echoed to stdout unchanged so that the usual
+// go test output is still readable while the report is being written.
+package main
+
+import (
+	"bufio"
+	"encoding/json"
+	"encoding/xml"
+	"flag"
+	"fmt"
+	"os"
+	"sort"
+	"strings"
+)
+
+type testEvent struct {
+	Action  string  `json:"Action"`
+	Package string  `json:"Package"`
+	Test    string  `json:"Test"`
+	Elapsed float64 `json:"Elapsed"`
+	Output  string  `json:"Output"`
+}
+
+type testCase struct {
+	Name    string
+	Package string
+	Action  string
+	Elapsed float64
+	Output  strings.Builder
+	Order   int
+}
+
+type junitFailure struct {
+	XMLName xml.Name `xml:"failure"`
+	Message string   `xml:"message,attr"`
+	Type    string   `xml:"type,attr,omitempty"`
+	Body    string   `xml:",chardata"`
+}
+
+type junitSkipped struct {
+	XMLName xml.Name `xml:"skipped"`
+	Message string   `xml:"message,attr"`
+}
+
+type junitTestCase struct {
+	XMLName   xml.Name      `xml:"testcase"`
+	Name      string        `xml:"name,attr"`
+	ClassName string        `xml:"classname,attr"`
+	Time      string        `xml:"time,attr"`
+	Failure   *junitFailure `xml:"failure,omitempty"`
+	Skipped   *junitSkipped `xml:"skipped,omitempty"`
+	SystemOut string        `xml:"system-out,omitempty"`
+}
+
+type junitTestSuite struct {
+	XMLName   xml.Name        `xml:"testsuite"`
+	Name      string          `xml:"name,attr"`
+	Tests     int             `xml:"tests,attr"`
+	Failures  int             `xml:"failures,attr"`
+	Skipped   int             `xml:"skipped,attr"`
+	Errors    int             `xml:"errors,attr"`
+	Time      string          `xml:"time,attr"`
+	TestCases []junitTestCase `xml:"testcase"`
+}
+
+type junitTestSuites struct {
+	XMLName  xml.Name         `xml:"testsuites"`
+	Tests    int              `xml:"tests,attr"`
+	Failures int              `xml:"failures,attr"`
+	Suites   []junitTestSuite `xml:"testsuite"`
+}
+
+func main() {
+	out := flag.String("out", "", "path to write the JUnit XML report to")
+	flag.Parse()
+
+	cases := map[string]*testCase{}
+	packageOutput := map[string]*strings.Builder{}
+	packageFailed := map[string]bool{}
+	order := 0
+
+	stdout := bufio.NewWriter(os.Stdout)
+	defer stdout.Flush()
+
+	scanner := bufio.NewScanner(os.Stdin)
+	scanner.Buffer(make([]byte, 0, 1024*1024), 16*1024*1024)
+
+	for scanner.Scan() {
+		line := scanner.Bytes()
+
+		var event testEvent
+		if err := json.Unmarshal(line, &event); err != nil {
+			// not a json line, pass it through so nothing is hidden
+			fmt.Fprintln(stdout, string(line))
+			continue
+		}
+
+		if event.Output != "" {
+			fmt.Fprint(stdout, event.Output)
+		}
+
+		if event.Test == "" {
+			if _, seen := packageOutput[event.Package]; !seen {
+				packageOutput[event.Package] = &strings.Builder{}
+			}
+			if event.Output != "" {
+				packageOutput[event.Package].WriteString(event.Output)
+			}
+			if event.Action == "fail" {
+				packageFailed[event.Package] = true
+			}
+			continue
+		}
+
+		key := event.Package + "\x00" + event.Test
+		entry, seen := cases[key]
+		if !seen {
+			entry = &testCase{Name: event.Test, Package: event.Package, Order: order}
+			order++
+			cases[key] = entry
+		}
+
+		if event.Output != "" {
+			entry.Output.WriteString(event.Output)
+		}
+		switch event.Action {
+		case "pass", "fail", "skip":
+			entry.Action = event.Action
+			entry.Elapsed = event.Elapsed
+		}
+	}
+
+	if err := scanner.Err(); err != nil {
+		fmt.Fprintf(os.Stderr, "junitreport: could not read test output: %v\n", err)
+	}
+
+	if *out == "" {
+		return
+	}
+
+	if err := writeReport(*out, cases, packageOutput, packageFailed); err != nil {
+		fmt.Fprintf(os.Stderr, "junitreport: could not write report: %v\n", err)
+	}
+}
+
+func writeReport(path string, cases map[string]*testCase, packageOutput map[string]*strings.Builder, packageFailed map[string]bool) error {
+	byPackage := map[string][]*testCase{}
+	for _, entry := range cases {
+		byPackage[entry.Package] = append(byPackage[entry.Package], entry)
+	}
+
+	// a package that failed without any failing test failed to build or panicked,
+	// so record that as its own test case rather than losing it
+	for pkg, failed := range packageFailed {
+		if !failed {
+			continue
+		}
+		hasFailure := false
+		for _, entry := range byPackage[pkg] {
+			if entry.Action == "fail" {
+				hasFailure = true
+				break
+			}
+		}
+		if hasFailure {
+			continue
+		}
+		synthetic := &testCase{Name: "PackageFailure", Package: pkg, Action: "fail", Order: -1}
+		if builder, ok := packageOutput[pkg]; ok {
+			synthetic.Output.WriteString(builder.String())
+		}
+		byPackage[pkg] = append(byPackage[pkg], synthetic)
+	}
+
+	packages := make([]string, 0, len(byPackage))
+	for pkg := range byPackage {
+		packages = append(packages, pkg)
+	}
+	sort.Strings(packages)
+
+	report := junitTestSuites{}
+	for _, pkg := range packages {
+		entries := byPackage[pkg]
+		sort.Slice(entries, func(i, j int) bool { return entries[i].Order < entries[j].Order })
+
+		suite := junitTestSuite{Name: pkg}
+		total := 0.0
+		for _, entry := range entries {
+			total += entry.Elapsed
+			testcase := junitTestCase{
+				Name:      entry.Name,
+				ClassName: pkg,
+				Time:      fmt.Sprintf("%.3f", entry.Elapsed),
+			}
+			switch entry.Action {
+			case "fail":
+				testcase.Failure = &junitFailure{
+					Message: "Failed",
+					Type:    "go.test.failure",
+					Body:    scrub(entry.Output.String()),
+				}
+				suite.Failures++
+			case "skip":
+				testcase.Skipped = &junitSkipped{Message: "Skipped"}
+				suite.Skipped++
+			default:
+				testcase.SystemOut = scrub(entry.Output.String())
+			}
+			suite.TestCases = append(suite.TestCases, testcase)
+			suite.Tests++
+		}
+		suite.Time = fmt.Sprintf("%.3f", total)
+		report.Tests += suite.Tests
+		report.Failures += suite.Failures
+		report.Suites = append(report.Suites, suite)
+	}
+
+	encoded, err := xml.MarshalIndent(report, "", "  ")
+	if err != nil {
+		return err
+	}
+
+	return os.WriteFile(path, append([]byte(xml.Header), append(encoded, '\n')...), 0644)
+}
+
+// scrub drops the control characters that are not legal in XML character data.
+func scrub(value string) string {
+	return strings.Map(func(r rune) rune {
+		if r == '\t' || r == '\n' || r == '\r' {
+			return r
+		}
+		if r < 0x20 {
+			return -1
+		}
+		return r
+	}, value)
+}
diff --git a/test.sh b/test.sh
new file mode 100755
index 0000000..6d0be26
--- /dev/null
+++ b/test.sh
@@ -0,0 +1,56 @@
+#!/usr/bin/env bash
+#
+# Usage:
+#   ./test.sh [--output_path <junit.xml>] <base|new>
+#
+#   base  runs existing suites that must pass both before and after the change.
+#   new   runs the soft delete suites. They fail before the change and pass
+#         after it.
+#
+# A JUnit XML report is written to --output_path when one is given.
+set -uo pipefail
+
+cd "$(dirname "$0")" || exit 2
+
+OUTPUT_PATH=""
+if [ "${1:-}" = "--output_path" ]; then
+  if [ -z "${2:-}" ]; then
+    echo "--output_path needs a value" >&2
+    exit 2
+  fi
+  OUTPUT_PATH="$2"
+  shift 2
+fi
+
+MODE="${1:-new}"
+
+# every dependency is in the module cache after the image build, so refuse to
+# reach out for anything at test time
+export GOPROXY=off
+export CGO_ENABLED=0
+
+RUN_ARGS=()
+
+case "$MODE" in
+  base)
+    PACKAGES=(./forms/ ./mails/ ./tools/search/ ./tools/dbutils/ ./tools/inflector/ ./tools/list/ ./tools/picker/)
+    ;;
+  new)
+    PACKAGES=(./core/ ./apis/)
+    RUN_ARGS=(-run '^TestSoftDelete')
+    ;;
+  *)
+    echo "unknown mode: $MODE (expected base or new)" >&2
+    exit 2
+    ;;
+esac
+
+REPORTER_ARGS=()
+if [ -n "$OUTPUT_PATH" ]; then
+  REPORTER_ARGS=(-out "$OUTPUT_PATH")
+fi
+
+go test -count=1 -json "${RUN_ARGS[@]}" "${PACKAGES[@]}" | go run ./scripts/junitreport "${REPORTER_ARGS[@]}"
+STATUS=${PIPESTATUS[0]}
+
+exit "$STATUS"
