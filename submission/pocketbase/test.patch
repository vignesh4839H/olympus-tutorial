+func TestSoftDeleteRestoreGroupIgnoresMemberOrder(t *testing.T) {
+	app, _ := tests.NewTestApp()
+	defer app.Cleanup()
+
+	root, middle, child := sdDependencyChain(t, app)
+
+	rootRecord := sdNewRecord(t, app, root, map[string]any{"title": "root"})
+	middleRecord := sdNewRecord(t, app, middle, map[string]any{"root": rootRecord.Id})
+	childRecord := sdNewRecord(t, app, child, map[string]any{
+		"root":   rootRecord.Id,
+		"middle": middleRecord.Id,
+	})
+
+	if err := app.Delete(rootRecord); err != nil {
+		t.Fatal(err)
+	}
+
+	all := []*core.Record{rootRecord, middleRecord, childRecord}
+
+	// the single delete must produce one group
+	var stamp string
+	for _, record := range all {
+		trashed, err := app.FindRecordByIdWithTrashed(record.Collection(), record.Id)
+		if err != nil {
+			t.Fatalf("%s: %v", record.Collection().Name, err)
+		}
+
+		if !trashed.IsTrashed() {
+			t.Fatalf("expected the %s record to be trashed", record.Collection().Name)
+		}
+
+		if stamp == "" {
+			stamp = trashed.TrashedAt().String()
+		} else if trashed.TrashedAt().String() != stamp {
+			t.Fatalf("expected one shared timestamp, got %q and %q", stamp, trashed.TrashedAt().String())
+		}
+	}
+
+	trashedRoot, err := app.FindTrashedRecordById(root, rootRecord.Id)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	// a member depending on another member must not block the group
+	if err := app.RestoreRecord(trashedRoot); err != nil {
+		t.Fatalf("expected the group to be restorable, got %v", err)
+	}
+
+	for _, record := range all {
+		if _, err := app.FindRecordById(record.Collection(), record.Id); err != nil {
+			t.Fatalf("expected the %s record to come back, got %v", record.Collection().Name, err)
+		}
+	}
