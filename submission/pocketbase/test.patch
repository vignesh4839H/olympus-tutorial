+func TestSoftDeletePurgeExpiredUsesEachCollectionRetention(t *testing.T) {
+	app, _ := tests.NewTestApp()
+	defer app.Cleanup()
+
+	// one hour and one day, so a record older than an hour outlives only the
+	// first; the retentions are written as literals so that the test does not
+	// pin the field to a particular integer type
+	short := core.NewBaseCollection("sd_retention_short")
+	short.SoftDelete = true
+	short.TrashRetention = 3600
+	short.Fields.Add(&core.TextField{Name: "title"})
+	if err := app.Save(short); err != nil {
+		t.Fatal(err)
+	}
+
+	long := core.NewBaseCollection("sd_retention_long")
+	long.SoftDelete = true
+	long.TrashRetention = 86400
+	long.Fields.Add(&core.TextField{Name: "title"})
+	if err := app.Save(long); err != nil {
+		t.Fatal(err)
+	}
+
+	shortRecord := sdNewRecord(t, app, short, map[string]any{"title": "short"})
+	longRecord := sdNewRecord(t, app, long, map[string]any{"title": "long"})
+
+	for _, pair := range []struct {
+		collection *core.Collection
+		record     *core.Record
+	}{{short, shortRecord}, {long, longRecord}} {
+		if err := app.Delete(pair.record); err != nil {
+			t.Fatal(err)
+		}
+
+		_, err := app.DB().Update(
+			pair.collection.Name,
+			dbx.Params{core.FieldNameDeleted: types.NowDateTime().Add(-2 * time.Hour).String()},
+			dbx.HashExp{"id": pair.record.Id},
+		).Execute()
+		if err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	if err := app.PurgeExpiredTrashedRecords(); err != nil {
+		t.Fatal(err)
+	}
+
+	if sdRawExists(t, app, short, shortRecord.Id) {
+		t.Fatal("expected the record past the one hour retention to be removed")
+	}
+
+	if !sdRawExists(t, app, long, longRecord.Id) {
+		t.Fatal("expected the record still inside the one day retention to be kept")
+	}
+}
