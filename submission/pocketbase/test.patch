@@ -0,0 +1,852 @@
+package softdeletetests
+
+import (
+	"net/http"
+	"strings"
+	"testing"
+
+	"github.com/pocketbase/dbx"
+	"github.com/pocketbase/pocketbase/core"
+	"github.com/pocketbase/pocketbase/tests"
+)
+
+const sdSuperuserToken = "eyJhbGciOiJIUzI1NiJ9.eyJpZCI6InN5d2JoZWNuaDQ2cmhtMCIsInR5cGUiOiJhdXRoIiwiY29sbGVjdGlvbklkIjoicGJjXzMxNDI2MzU4MjMiLCJleHAiOjI1MjQ2MDQ0NjEsInJlZnJlc2hhYmxlIjp0cnVlfQ.UXgO3j-0BumcugrFjbd7j0M4MQvbrLggLlcu_YNGjoY"
+
+const (
+	sdLiveRecordId    = "sdapilive000001"
+	sdTrashedRecordId = "sdapitrashed001"
+	sdPlainRecordId   = "sdapiplain00001"
+)
+
+// sdApiSetup creates a public soft delete enabled collection holding one live
+// and one trashed record, plus a regular collection for the fallback checks.
+func sdApiSetup(t testing.TB, app core.App) {
+	t.Helper()
+
+	publicRule := ""
+
+	posts := core.NewBaseCollection("sd_api_posts")
+	posts.SoftDelete = true
+	posts.Fields.Add(&core.TextField{Name: "title"})
+	posts.ListRule = &publicRule
+	posts.ViewRule = &publicRule
+	posts.CreateRule = &publicRule
+	posts.UpdateRule = &publicRule
+	posts.DeleteRule = &publicRule
+	if err := app.Save(posts); err != nil {
+		t.Fatalf("failed to save sd_api_posts: %v", err)
+	}
+
+	plain := core.NewBaseCollection("sd_api_plain")
+	plain.Fields.Add(&core.TextField{Name: "title"})
+	plain.ListRule = &publicRule
+	plain.ViewRule = &publicRule
+	plain.CreateRule = &publicRule
+	plain.UpdateRule = &publicRule
+	plain.DeleteRule = &publicRule
+	if err := app.Save(plain); err != nil {
+		t.Fatalf("failed to save sd_api_plain: %v", err)
+	}
+
+	live := core.NewRecord(posts)
+	live.Id = sdLiveRecordId
+	live.Set("title", "live one")
+	if err := app.Save(live); err != nil {
+		t.Fatalf("failed to save the live record: %v", err)
+	}
+
+	trashed := core.NewRecord(posts)
+	trashed.Id = sdTrashedRecordId
+	trashed.Set("title", "trashed one")
+	if err := app.Save(trashed); err != nil {
+		t.Fatalf("failed to save the trashed record: %v", err)
+	}
+	if err := app.Delete(trashed); err != nil {
+		t.Fatalf("failed to trash the record: %v", err)
+	}
+
+	other := core.NewRecord(plain)
+	other.Id = sdPlainRecordId
+	other.Set("title", "plain one")
+	if err := app.Save(other); err != nil {
+		t.Fatalf("failed to save the plain record: %v", err)
+	}
+}
+
+func sdBefore(t testing.TB, app *tests.TestApp, e *core.ServeEvent) {
+	sdApiSetup(t, app)
+}
+
+func TestSoftDeleteRecordsListApi(t *testing.T) {
+	scenarios := []tests.ApiScenario{
+		{
+			Name:           "the trashed records are hidden by default",
+			Method:         http.MethodGet,
+			URL:            "/api/collections/sd_api_posts/records",
+			BeforeTestFunc: sdBefore,
+			ExpectedStatus: 200,
+			ExpectedContent: []string{
+				`"totalItems":1`,
+				`"id":"` + sdLiveRecordId + `"`,
+			},
+			NotExpectedContent: []string{
+				`"id":"` + sdTrashedRecordId + `"`,
+			},
+		},
+		{
+			Name:           "trashed=only lists just the trashed records",
+			Method:         http.MethodGet,
+			URL:            "/api/collections/sd_api_posts/records?trashed=only",
+			BeforeTestFunc: sdBefore,
+			ExpectedStatus: 200,
+			ExpectedContent: []string{
+				`"totalItems":1`,
+				`"id":"` + sdTrashedRecordId + `"`,
+			},
+			NotExpectedContent: []string{
+				`"id":"` + sdLiveRecordId + `"`,
+			},
+		},
+		{
+			Name:           "trashed=with lists both",
+			Method:         http.MethodGet,
+			URL:            "/api/collections/sd_api_posts/records?trashed=with",
+			BeforeTestFunc: sdBefore,
+			ExpectedStatus: 200,
+			ExpectedContent: []string{
+				`"totalItems":2`,
+				`"id":"` + sdLiveRecordId + `"`,
+				`"id":"` + sdTrashedRecordId + `"`,
+			},
+		},
+		{
+			Name:           "an unknown trashed value is rejected",
+			Method:         http.MethodGet,
+			URL:            "/api/collections/sd_api_posts/records?trashed=yes",
+			BeforeTestFunc: sdBefore,
+			ExpectedStatus: 400,
+			ExpectedContent: []string{
+				`"data":`,
+			},
+		},
+		{
+			Name:           "the parameter is ignored for regular collections",
+			Method:         http.MethodGet,
+			URL:            "/api/collections/sd_api_plain/records?trashed=only",
+			BeforeTestFunc: sdBefore,
+			ExpectedStatus: 200,
+			ExpectedContent: []string{
+				`"totalItems":1`,
+				`"id":"` + sdPlainRecordId + `"`,
+			},
+		},
+	}
+
+	for _, scenario := range scenarios {
+		scenario.Test(t)
+	}
+}
+
+func TestSoftDeleteRecordViewApi(t *testing.T) {
+	scenarios := []tests.ApiScenario{
+		{
+			Name:           "a trashed record is not viewable",
+			Method:         http.MethodGet,
+			URL:            "/api/collections/sd_api_posts/records/" + sdTrashedRecordId,
+			BeforeTestFunc: sdBefore,
+			ExpectedStatus: 404,
+			ExpectedContent: []string{
+				`"data":`,
+			},
+		},
+		{
+			Name:           "a trashed record is viewable with trashed=with",
+			Method:         http.MethodGet,
+			URL:            "/api/collections/sd_api_posts/records/" + sdTrashedRecordId + "?trashed=with",
+			BeforeTestFunc: sdBefore,
+			ExpectedStatus: 200,
+			ExpectedContent: []string{
+				`"id":"` + sdTrashedRecordId + `"`,
+			},
+		},
+		{
+			Name:           "the parameter is ignored for regular collections",
+			Method:         http.MethodGet,
+			URL:            "/api/collections/sd_api_plain/records/" + sdPlainRecordId + "?trashed=only",
+			BeforeTestFunc: sdBefore,
+			ExpectedStatus: 200,
+			ExpectedContent: []string{
+				`"id":"` + sdPlainRecordId + `"`,
+			},
+		},
+		{
+			Name:           "a live record is not viewable with trashed=only",
+			Method:         http.MethodGet,
+			URL:            "/api/collections/sd_api_posts/records/" + sdLiveRecordId + "?trashed=only",
+			BeforeTestFunc: sdBefore,
+			ExpectedStatus: 404,
+			ExpectedContent: []string{
+				`"data":`,
+			},
+		},
+	}
+
+	for _, scenario := range scenarios {
+		scenario.Test(t)
+	}
+}
+
+func TestSoftDeleteRecordDeleteApi(t *testing.T) {
+	scenarios := []tests.ApiScenario{
+		{
+			Name:           "deleting moves the record to the trash",
+			Method:         http.MethodDelete,
+			URL:            "/api/collections/sd_api_posts/records/" + sdLiveRecordId,
+			BeforeTestFunc: sdBefore,
+			ExpectedStatus: 204,
+			AfterTestFunc: func(t testing.TB, app *tests.TestApp, res *http.Response) {
+				if _, err := app.FindTrashedRecordById("sd_api_posts", sdLiveRecordId); err != nil {
+					t.Fatalf("expected the record to be trashed, got %v", err)
+				}
+			},
+		},
+		{
+			Name:           "purge removes the record permanently",
+			Method:         http.MethodDelete,
+			URL:            "/api/collections/sd_api_posts/records/" + sdLiveRecordId + "?purge=true",
+			BeforeTestFunc: sdBefore,
+			ExpectedStatus: 204,
+			AfterTestFunc: func(t testing.TB, app *tests.TestApp, res *http.Response) {
+				if _, err := app.FindRecordByIdWithTrashed("sd_api_posts", sdLiveRecordId); err == nil {
+					t.Fatal("expected the record to be permanently deleted")
+				}
+			},
+		},
+		{
+			Name:           "purge reaches the already trashed records",
+			Method:         http.MethodDelete,
+			URL:            "/api/collections/sd_api_posts/records/" + sdTrashedRecordId + "?purge=true",
+			BeforeTestFunc: sdBefore,
+			ExpectedStatus: 204,
+			AfterTestFunc: func(t testing.TB, app *tests.TestApp, res *http.Response) {
+				if _, err := app.FindRecordByIdWithTrashed("sd_api_posts", sdTrashedRecordId); err == nil {
+					t.Fatal("expected the record to be permanently deleted")
+				}
+			},
+		},
+		{
+			Name:           "a non-boolean purge value is rejected",
+			Method:         http.MethodDelete,
+			URL:            "/api/collections/sd_api_posts/records/" + sdLiveRecordId + "?purge=maybe",
+			BeforeTestFunc: sdBefore,
+			ExpectedStatus: 400,
+			ExpectedContent: []string{
+				`"data":`,
+			},
+		},
+		{
+			Name:           "a trashed record cannot be deleted without purge",
+			Method:         http.MethodDelete,
+			URL:            "/api/collections/sd_api_posts/records/" + sdTrashedRecordId,
+			BeforeTestFunc: sdBefore,
+			ExpectedStatus: 404,
+			ExpectedContent: []string{
+				`"data":`,
+			},
+		},
+	}
+
+	for _, scenario := range scenarios {
+		scenario.Test(t)
+	}
+}
+
+func TestSoftDeleteRecordRestoreApi(t *testing.T) {
+	scenarios := []tests.ApiScenario{
+		{
+			Name:           "restoring a trashed record",
+			Method:         http.MethodPost,
+			URL:            "/api/collections/sd_api_posts/records/" + sdTrashedRecordId + "/restore",
+			BeforeTestFunc: sdBefore,
+			ExpectedStatus: 200,
+			ExpectedContent: []string{
+				`"id":"` + sdTrashedRecordId + `"`,
+				`"title":"trashed one"`,
+			},
+			AfterTestFunc: func(t testing.TB, app *tests.TestApp, res *http.Response) {
+				if _, err := app.FindRecordById("sd_api_posts", sdTrashedRecordId); err != nil {
+					t.Fatalf("expected the record to be restored, got %v", err)
+				}
+			},
+		},
+		{
+			Name:           "restoring a live record is not found",
+			Method:         http.MethodPost,
+			URL:            "/api/collections/sd_api_posts/records/" + sdLiveRecordId + "/restore",
+			BeforeTestFunc: sdBefore,
+			ExpectedStatus: 404,
+			ExpectedContent: []string{
+				`"data":`,
+			},
+		},
+		{
+			Name:   "the restore action works through the batch endpoint",
+			Method: http.MethodPost,
+			URL:    "/api/batch",
+			Body: strings.NewReader(`{
+				"requests": [
+					{"method":"POST", "url":"/api/collections/sd_api_posts/records/` + sdTrashedRecordId + `/restore"}
+				]
+			}`),
+			BeforeTestFunc: func(t testing.TB, app *tests.TestApp, e *core.ServeEvent) {
+				sdApiSetup(t, app)
+				app.Settings().Batch.Enabled = true
+			},
+			ExpectedStatus: 200,
+			ExpectedContent: []string{
+				`"id":"` + sdTrashedRecordId + `"`,
+			},
+			AfterTestFunc: func(t testing.TB, app *tests.TestApp, res *http.Response) {
+				if _, err := app.FindRecordById("sd_api_posts", sdTrashedRecordId); err != nil {
+					t.Fatalf("expected the batched restore to bring the record back, got %v", err)
+				}
+			},
+		},
+		{
+			Name:   "a nonempty update rule that does not match refuses the restore",
+			Method: http.MethodPost,
+			URL:    "/api/collections/sd_api_posts/records/" + sdTrashedRecordId + "/restore",
+			BeforeTestFunc: func(t testing.TB, app *tests.TestApp, e *core.ServeEvent) {
+				sdApiSetup(t, app)
+
+				collection, err := app.FindCollectionByNameOrId("sd_api_posts")
+				if err != nil {
+					t.Fatal(err)
+				}
+
+				// the trashed record is titled "trashed one", so the rule below
+				// keeps it out and the restore has to respect that
+				rule := "title = 'allowed'"
+				collection.UpdateRule = &rule
