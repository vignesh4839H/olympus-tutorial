+func TestSoftDeleteIsScopedToBaseCollections(t *testing.T) {
+	app, _ := tests.NewTestApp()
+	defer app.Cleanup()
+
+	t.Run("an auth collection does not gain the mode", func(t *testing.T) {
+		users, err := app.FindCollectionByNameOrId("users")
+		if err != nil {
+			t.Fatal(err)
+		}
+
+		users.SoftDelete = true
+
+		// the save may be refused outright or simply carry no meaning here,
+		// so its result is deliberately not pinned; what matters is that the
+		// collection does not start behaving like a soft delete one
+		_ = app.Save(users)
+
+		reloaded, err := app.FindCollectionByNameOrId("users")
+		if err != nil {
+			t.Fatal(err)
+		}
+
+		if reloaded.Fields.GetByName(core.FieldNameDeleted) != nil {
+			t.Fatal("expected an auth collection to gain no deleted field")
+		}
+
+		if _, err := app.FindAllTrashedRecords(reloaded); err == nil {
+			t.Fatal("expected the trash lookups to stay unsupported for an auth collection")
+		}
+
+		records, err := app.FindAllRecords(reloaded)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if len(records) == 0 {
+			t.Fatal("expected the fixture to have at least one auth record")
+		}
+
+		record := records[0]
+		if err := app.Delete(record); err != nil {
+			t.Fatal(err)
+		}
+
+		if sdRawExists(t, app, reloaded, record.Id) {
+			t.Fatal("expected an auth record to be removed rather than trashed")
+		}
+	})
+
+	t.Run("a view collection does not gain the mode", func(t *testing.T) {
+		source := core.NewBaseCollection("sd_scope_source")
+		source.Fields.Add(&core.TextField{Name: "title"})
+		if err := app.Save(source); err != nil {
+			t.Fatal(err)
+		}
+
+		view := core.NewViewCollection("sd_scope_view")
+		view.ViewQuery = "SELECT id, title FROM sd_scope_source"
+		if err := app.Save(view); err != nil {
+			t.Fatal(err)
+		}
+
+		view.SoftDelete = true
+		_ = app.Save(view)
+
+		reloaded, err := app.FindCollectionByNameOrId("sd_scope_view")
+		if err != nil {
+			t.Fatal(err)
+		}
+
+		if reloaded.Fields.GetByName(core.FieldNameDeleted) != nil {
+			t.Fatal("expected a view collection to gain no deleted field")
+		}
+
+		if _, err := app.FindAllTrashedRecords(reloaded); err == nil {
+			t.Fatal("expected the trash lookups to stay unsupported for a view collection")
+		}
+	})
+}
