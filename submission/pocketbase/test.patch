+func TestSoftDeleteRecordDeleteApi(t *testing.T) {
+	scenarios := []tests.ApiScenario{
+		{
+			Name:           "deleting moves the record to the trash",
+			Method:         http.MethodDelete,
+			URL:            "/api/collections/sd_api_posts/records/" + sdLiveRecordId,
+			BeforeTestFunc: sdBefore,
+			ExpectedStatus: 204,
+			AfterTestFunc: func(t testing.TB, app *tests.TestApp, res *http.Response) {
+				if _, err := app.FindTrashedRecordById("sd_api_posts", sdLiveRecordId); err != nil {
+					t.Fatalf("expected the record to be trashed, got %v", err)
+				}
+			},
+		},
+		{
+			Name:           "purge removes the record permanently",
+			Method:         http.MethodDelete,
+			URL:            "/api/collections/sd_api_posts/records/" + sdLiveRecordId + "?purge=true",
+			BeforeTestFunc: sdBefore,
+			ExpectedStatus: 204,
+			AfterTestFunc: func(t testing.TB, app *tests.TestApp, res *http.Response) {
+				if _, err := app.FindRecordByIdWithTrashed("sd_api_posts", sdLiveRecordId); err == nil {
+					t.Fatal("expected the record to be permanently deleted")
+				}
+			},
+		},
+		{
+			Name:           "purge reaches the already trashed records",
+			Method:         http.MethodDelete,
+			URL:            "/api/collections/sd_api_posts/records/" + sdTrashedRecordId + "?purge=true",
+			BeforeTestFunc: sdBefore,
+			ExpectedStatus: 204,
+			AfterTestFunc: func(t testing.TB, app *tests.TestApp, res *http.Response) {
+				if _, err := app.FindRecordByIdWithTrashed("sd_api_posts", sdTrashedRecordId); err == nil {
+					t.Fatal("expected the record to be permanently deleted")
+				}
+			},
+		},
+		{
+			Name:           "a non-boolean purge value is rejected",
+			Method:         http.MethodDelete,
+			URL:            "/api/collections/sd_api_posts/records/" + sdLiveRecordId + "?purge=maybe",
+			BeforeTestFunc: sdBefore,
+			ExpectedStatus: 400,
+			ExpectedContent: []string{
+				`"data":`,
+			},
+		},
+		{
+			Name:           "a trashed record cannot be deleted without purge",
+			Method:         http.MethodDelete,
+			URL:            "/api/collections/sd_api_posts/records/" + sdTrashedRecordId,
+			BeforeTestFunc: sdBefore,
+			ExpectedStatus: 404,
+			ExpectedContent: []string{
+				`"data":`,
+			},
+		},
+	}
+
+	for _, scenario := range scenarios {
+		scenario.Test(t)
+	}
+}
