+	if err := app.Save(conflict); err == nil {
+		t.Fatal("expected the original unique condition to still reject a second active row")
+	}
+
+	// ... and the trashed rows drop out of it
+	if err := app.Delete(active); err != nil {
+		t.Fatal(err)
+	}
+
+	replacement := core.NewRecord(collection)
+	replacement.Set("title", "same")
+	replacement.Set("status", "active")
+	if err := app.Save(replacement); err != nil {
+		t.Fatalf("expected the trashed row to free its unique value, got %v", err)
