+	t.Run("the cascade comments are trashed as well", func(t *testing.T) {
+		live, err := app.FindAllRecords(comments)
+		if err != nil {
+			t.Fatal(err)
+		}
+
+		if len(live) != 0 {
+			t.Fatalf("expected no live comments, got %v", sdFindIds(t, live))
+		}
+
+		if !sdRawExists(t, app, comments, c1.Id) {
+			t.Fatal("expected the comment row to be kept")
+		}
+	})
+
+	t.Run("the group shares the trash timestamp", func(t *testing.T) {
+		trashedPost, err := app.FindTrashedRecordById(posts, post.Id)
+		if err != nil {
+			t.Fatal(err)
+		}
+
+		trashedComment, err := app.FindTrashedRecordById(comments, c1.Id)
+		if err != nil {
+			t.Fatal(err)
+		}
+
+		if trashedPost.TrashedAt().String() != trashedComment.TrashedAt().String() {
+			t.Fatalf(
+				"expected an equal trash timestamp, got %q and %q",
+				trashedPost.TrashedAt().String(),
+				trashedComment.TrashedAt().String(),
+			)
+		}
+	})
+
+	t.Run("restoring the post restores only its group", func(t *testing.T) {
+		trashedPost, err := app.FindTrashedRecordById(posts, post.Id)
+		if err != nil {
+			t.Fatal(err)
+		}
+
+		if err := app.RestoreRecord(trashedPost); err != nil {
+			t.Fatal(err)
+		}
+
+		if _, err := app.FindRecordById(comments, c1.Id); err != nil {
+			t.Fatalf("expected the cascade comment to be restored, got %v", err)
+		}
+
+		if _, err := app.FindRecordById(comments, c2.Id); !errors.Is(err, sql.ErrNoRows) {
+			t.Fatalf("expected the separately trashed comment to stay in the trash, got %v", err)
+		}
+	})
+}
