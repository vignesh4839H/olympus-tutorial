+	collection := core.NewBaseCollection("sd_partial_index")
+	collection.Fields.Add(&core.TextField{Name: "title"})
+	collection.Fields.Add(&core.TextField{Name: "status"})
+	// the constraint only ever applied to the "active" rows
+	collection.AddIndex("idx_sd_partial_title", true, "`title`", "`status` = 'active'")
