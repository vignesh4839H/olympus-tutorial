+func TestSoftDeleteRestoreStartsFromAnyMemberOfEitherShape(t *testing.T) {
+	// a chain, where each level depends on the one above it, and a star,
+	// where two dependents hang off one record; the restore has to work from
+	// every member of either
+	shapes := []struct {
+		name  string
+		build func(t *testing.T, app core.App) (*core.Record, []*core.Record)
+	}{
+		{
+			name: "chain",
+			build: func(t *testing.T, app core.App) (*core.Record, []*core.Record) {
+				root, middle, child := sdDependencyChain(t, app)
+
+				rootRecord := sdNewRecord(t, app, root, map[string]any{"title": "root"})
+				middleRecord := sdNewRecord(t, app, middle, map[string]any{"root": rootRecord.Id})
+				childRecord := sdNewRecord(t, app, child, map[string]any{
+					"root":   rootRecord.Id,
+					"middle": middleRecord.Id,
+				})
+
+				return rootRecord, []*core.Record{rootRecord, middleRecord, childRecord}
+			},
+		},
+		{
+			name: "star",
+			build: func(t *testing.T, app core.App) (*core.Record, []*core.Record) {
+				posts, comments, _ := sdSetup(t, app)
+
+				post := sdNewRecord(t, app, posts, map[string]any{"title": "star"})
+				first := sdNewRecord(t, app, comments, map[string]any{"message": "one", "post": post.Id})
+				second := sdNewRecord(t, app, comments, map[string]any{"message": "two", "post": post.Id})
+
+				return post, []*core.Record{post, first, second}
+			},
+		},
+	}
+
+	for _, shape := range shapes {
+		for position := range 3 {
+			t.Run(fmt.Sprintf("%s from position %d", shape.name, position), func(t *testing.T) {
+				app, _ := tests.NewTestApp()
+				defer app.Cleanup()
+
+				deleteFrom, members := shape.build(t, app)
+
+				if err := app.Delete(deleteFrom); err != nil {
+					t.Fatal(err)
+				}
+
+				start := members[position]
+
+				trashed, err := app.FindTrashedRecordById(start.Collection(), start.Id)
+				if err != nil {
+					t.Fatalf("expected every member to be in the trash, got %v", err)
+				}
+
+				if err := app.RestoreRecord(trashed); err != nil {
+					t.Fatalf("expected the group to restore from this member, got %v", err)
+				}
+
+				for _, member := range members {
+					if _, err := app.FindRecordById(member.Collection(), member.Id); err != nil {
+						t.Fatalf("expected the %s record to come back, got %v", member.Collection().Name, err)
+					}
+				}
+			})
+		}
+	}
+}
diff --git a/test.sh b/test.sh
new file mode 100755
index 0000000..34b146b
--- /dev/null
+++ b/test.sh
@@ -0,0 +1,123 @@
+#!/usr/bin/env bash
+#
+# Usage:
+#   ./test.sh [--output_path <junit.xml>] <base|new>
+#
+#   base  runs existing suites that must pass both before and after the change.
+#   new   runs the soft delete suites. They fail before the change and pass
+#         after it.
+#
+# A JUnit XML report is written to --output_path when one is given.
+set -uo pipefail
+
+cd "$(dirname "$0")" || exit 2
+
+OUTPUT_PATH=""
+if [ "${1:-}" = "--output_path" ]; then
+  if [ -z "${2:-}" ]; then
+    echo "--output_path needs a value" >&2
+    exit 2
+  fi
+  OUTPUT_PATH="$2"
+  shift 2
+fi
+
+MODE="${1:-new}"
+
+# every dependency is in the module cache after the image build, so refuse to
+# reach out for anything at test time
+export GOPROXY=off
+export CGO_ENABLED=0
+
+RUN_ARGS=()
+EXPECT_DIRS=()
+EXTRA_PACKAGES=()
+EXTRA_RUN_ARGS=()
+
+case "$MODE" in
+  base)
+    # the suites of the packages the change touches are the regression gate, so
+    # they run in full; the soft delete tests live in their own package and are
+    # not part of it
+    PACKAGES=(./core/ ./apis/ ./forms/ ./mails/ ./tools/search/ ./tools/dbutils/ ./tools/inflector/ ./tools/list/ ./tools/picker/)
+    # TestRecordAuthWithOAuth2 downloads an avatar over the network, which is
+    # not available here. The two TestNotifyWatcher cases wait on a filesystem
+    # watcher shared by two apps within a fixed one to three second budget, so
+    # they turn on how loaded the machine is rather than on the code.
+    # TestRealtimeRecordResolve is the same story: it gives each of its
+    # scenarios a fixed 250ms window to collect the events of a create, an
+    # update and a delete, and it hands every scenario the same four
+    # subscription clients, so both how many events arrive in time and which
+    # client they are counted against depend on the machine. The rest
+    # build their subtest names out of pointer addresses and random file names,
+    # so the names differ between runs even though the results never do, which
+    # makes a report diff look unstable.
+    RUN_ARGS=(-skip '^(TestRecordAuthWithOAuth2|TestBatchRequest|TestNotifyWatcher_CollectionsUpdate|TestNotifyWatcher_SettingsUpdate|TestRealtimeRecordResolve|TestFileFieldDriverValue|TestFileFieldPrepareValue|TestRecordGetBool|TestRecordGetDateTime|TestRecordGetFloat|TestRecordGetInt|TestRecordGetInt64|TestRecordGetStringSlice)$')
+    # TestBatchRequest is skipped above only to drop one of its cases:
+    # "transaction timeout" gives the batch a one second budget and sleeps
+    # 600ms per request, so which request the deadline lands on depends on
+    # how loaded the machine is. Go matches -skip a level at a time and takes
+    # a single pattern, so the rest of the test comes back in a second pass.
+    EXTRA_PACKAGES=(./apis/)
+    EXTRA_RUN_ARGS=(-run '^TestBatchRequest$' -skip '^TestBatchRequest$/^transaction_timeout$')
+    ;;
+  new)
+    PACKAGES=(./softdeletetests/)
+    RUN_ARGS=(-run '^TestSoftDelete')
+    EXPECT_DIRS=(softdeletetests)
+    ;;
+  *)
+    echo "unknown mode: $MODE (expected base or new)" >&2
+    exit 2
+    ;;
+esac
+
+REPORTER_ARGS=()
+if [ -n "$OUTPUT_PATH" ]; then
+  REPORTER_ARGS=(-out "$OUTPUT_PATH")
+fi
+
+# A package that does not compile produces no test events, so the reporter is
+# told up front which tests each package holds. Without it a build failure
+# could only be reported against the package as a whole, and a report entry
+# that names no test cannot be matched to anything.
+MODULE="$(go list -m 2>/dev/null || true)"
+for DIR in ${EXPECT_DIRS[@]+"${EXPECT_DIRS[@]}"}; do
+  [ -n "$MODULE" ] || break
+
+  NAMES="$(
+    grep -hoE '^func TestSoftDelete[A-Za-z0-9_]*\(' "$DIR"/*_test.go 2>/dev/null |
+      sed -E 's/^func //; s/\($//' |
+      sort -u |
+      paste -sd, -
+  )"
+
+  if [ -n "$NAMES" ]; then
+    REPORTER_ARGS+=(-expect "$MODULE/$DIR=$NAMES")
+  fi
+done
+
+# the suites are run as one stream so that a single report covers them all,
+# and the worst status of the runs is the status of the whole thing
+run_suites() {
+  local rc=0
+
+  go test -count=1 -json ${RUN_ARGS[@]+"${RUN_ARGS[@]}"} "${PACKAGES[@]}" || rc=$?
+
+  if [ ${#EXTRA_PACKAGES[@]} -gt 0 ]; then
+    go test -count=1 -json ${EXTRA_RUN_ARGS[@]+"${EXTRA_RUN_ARGS[@]}"} "${EXTRA_PACKAGES[@]}" || rc=$?
+  fi
+
+  return "$rc"
+}
+
+run_suites | go run ./scripts/junitreport ${REPORTER_ARGS[@]+"${REPORTER_ARGS[@]}"}
+STATUS=("${PIPESTATUS[@]}")
+
+# a run is only a success when the tests passed and the requested report was
+# actually written, so the reporter's status counts too
+if [ "${STATUS[0]}" -ne 0 ]; then
+  exit "${STATUS[0]}"
+fi
+
+exit "${STATUS[1]}"
