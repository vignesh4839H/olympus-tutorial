+func TestSoftDeleteRapidDeletesAllGetDistinctTimestamps(t *testing.T) {
+	app, _ := tests.NewTestApp()
+	defer app.Cleanup()
+
+	posts, _, _ := sdSetup(t, app)
+
+	titles := []string{"one", "two", "three", "four", "five", "six"}
+
+	records := make([]*core.Record, 0, len(titles))
+	for _, title := range titles {
+		records = append(records, sdNewRecord(t, app, posts, map[string]any{"title": title}))
+	}
+
+	// back to back, so anything that only alternates between two stamps or
+	// leans on the clock ticking between calls shows up here
+	for _, record := range records {
+		if err := app.Delete(record); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	seen := map[string]string{}
+
+	for _, record := range records {
+		trashed, err := app.FindTrashedRecordById(posts, record.Id)
+		if err != nil {
+			t.Fatal(err)
+		}
+
+		stamp := trashed.TrashedAt().String()
+		if other, ok := seen[stamp]; ok {
+			t.Fatalf("expected every delete to get its own timestamp, %q and %q share %q", other, record.Id, stamp)
+		}
+
+		seen[stamp] = record.Id
+	}
+
+	if len(seen) != len(records) {
+		t.Fatalf("expected %d distinct timestamps, got %d", len(records), len(seen))
+	}
+}
