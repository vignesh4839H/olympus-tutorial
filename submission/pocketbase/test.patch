+// -------------------------------------------------------------------
+// helpers
+// -------------------------------------------------------------------
+
+// sdSetup creates the collections used by the soft delete tests:
+//
+//   - sd_posts    - soft delete enabled, unique index on "title"
+//   - sd_comments - soft delete enabled, cascade delete relation to sd_posts
+//   - sd_plain    - regular collection without the soft delete mode
+func sdSetup(t testing.TB, app core.App) (*core.Collection, *core.Collection, *core.Collection) {
+	t.Helper()
+
+	posts := core.NewBaseCollection("sd_posts")
+	posts.SoftDelete = true
+	posts.Fields.Add(&core.TextField{Name: "title"})
+	posts.AddIndex("idx_sd_posts_title", true, "`title`", "")
+	if err := app.Save(posts); err != nil {
+		t.Fatalf("failed to save sd_posts: %v", err)
+	}
+
+	comments := core.NewBaseCollection("sd_comments")
+	comments.SoftDelete = true
+	comments.Fields.Add(&core.TextField{Name: "message"})
+	comments.Fields.Add(&core.RelationField{
+		Name:          "post",
+		CollectionId:  posts.Id,
+		CascadeDelete: true,
+	})
+	if err := app.Save(comments); err != nil {
+		t.Fatalf("failed to save sd_comments: %v", err)
+	}
+
+	plain := core.NewBaseCollection("sd_plain")
+	plain.Fields.Add(&core.TextField{Name: "title"})
+	if err := app.Save(plain); err != nil {
+		t.Fatalf("failed to save sd_plain: %v", err)
+	}
+
+	return posts, comments, plain
+}
+
+func sdNewRecord(t testing.TB, app core.App, collection *core.Collection, data map[string]any) *core.Record {
+	t.Helper()
+
+	record := core.NewRecord(collection)
+	for k, v := range data {
+		record.Set(k, v)
+	}
+
+	if err := app.Save(record); err != nil {
+		t.Fatalf("failed to save %s record: %v", collection.Name, err)
+	}
+
+	return record
+}
