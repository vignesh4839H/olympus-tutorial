+// sdRawExists reports whether the record row is still physically in the table.
+func sdRawExists(t testing.TB, app core.App, collection *core.Collection, id string) bool {
+	t.Helper()
+
+	var total int
+
+	err := app.DB().Select("count(*)").
+		From(collection.Name).
+		AndWhere(dbx.HashExp{"id": id}).
+		Row(&total)
+	if err != nil {
+		t.Fatalf("failed to count the %s rows: %v", collection.Name, err)
+	}
+
+	return total > 0
+}
