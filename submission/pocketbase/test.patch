+func TestSoftDeleteRestoreStillRejectsDependenciesOutsideTheGroup(t *testing.T) {
+	app, _ := tests.NewTestApp()
+	defer app.Cleanup()
+
+	root, middle, child := sdDependencyChain(t, app)
+
+	rootRecord := sdNewRecord(t, app, root, map[string]any{"title": "root"})
+	middleRecord := sdNewRecord(t, app, middle, map[string]any{"root": rootRecord.Id})
+	childRecord := sdNewRecord(t, app, child, map[string]any{
+		"root":   rootRecord.Id,
+		"middle": middleRecord.Id,
+	})
+
+	// trashing the child on its own puts it in a group of its own
+	if err := app.Delete(childRecord); err != nil {
+		t.Fatal(err)
+	}
+
+	if err := app.Delete(middleRecord); err != nil {
+		t.Fatal(err)
+	}
+
+	trashedChild, err := app.FindTrashedRecordById(child, childRecord.Id)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	// the middle record was trashed separately, so it is not part of the
+	// child's group and must still block the restore
+	if err := app.RestoreRecord(trashedChild); err == nil {
+		t.Fatal("expected an error when a cascade dependency outside the group is still trashed")
+	}
+
+	if _, err := app.FindRecordById(child, childRecord.Id); err == nil {
+		t.Fatal("expected the child to stay in the trash after the rejected restore")
+	}
+
+	trashedMiddle, err := app.FindTrashedRecordById(middle, middleRecord.Id)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if err := app.RestoreRecord(trashedMiddle); err != nil {
+		t.Fatal(err)
+	}
+
+	// with the dependency live again the child restores on its own
+	trashedChild, err = app.FindTrashedRecordById(child, childRecord.Id)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if err := app.RestoreRecord(trashedChild); err != nil {
+		t.Fatalf("expected the child to be restorable once its dependency is live, got %v", err)
+	}
+}
