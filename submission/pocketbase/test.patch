+package core_test
+
+import (
+	"database/sql"
+	"errors"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/pocketbase/dbx"
+	"github.com/pocketbase/pocketbase/core"
+	"github.com/pocketbase/pocketbase/forms"
+	"github.com/pocketbase/pocketbase/tests"
+	"github.com/pocketbase/pocketbase/tools/types"
+)
+
+// -------------------------------------------------------------------
+// helpers
+// -------------------------------------------------------------------
+
+// sdSetup creates the collections used by the soft delete tests:
+//
+//   - sd_posts    - soft delete enabled, unique index on "title"
+//   - sd_comments - soft delete enabled, cascade delete relation to sd_posts
+//   - sd_plain    - regular collection without the soft delete mode
+func sdSetup(t testing.TB, app core.App) (*core.Collection, *core.Collection, *core.Collection) {
+	t.Helper()
+
+	posts := core.NewBaseCollection("sd_posts")
+	posts.SoftDelete = true
+	posts.Fields.Add(&core.TextField{Name: "title"})
+	posts.AddIndex("idx_sd_posts_title", true, "`title`", "")
+	if err := app.Save(posts); err != nil {
+		t.Fatalf("failed to save sd_posts: %v", err)
+	}
+
+	comments := core.NewBaseCollection("sd_comments")
+	comments.SoftDelete = true
+	comments.Fields.Add(&core.TextField{Name: "message"})
+	comments.Fields.Add(&core.RelationField{
+		Name:          "post",
+		CollectionId:  posts.Id,
+		CascadeDelete: true,
+	})
+	if err := app.Save(comments); err != nil {
+		t.Fatalf("failed to save sd_comments: %v", err)
+	}
+
+	plain := core.NewBaseCollection("sd_plain")
+	plain.Fields.Add(&core.TextField{Name: "title"})
+	if err := app.Save(plain); err != nil {
+		t.Fatalf("failed to save sd_plain: %v", err)
+	}
+
+	return posts, comments, plain
+}
+
+func sdNewRecord(t testing.TB, app core.App, collection *core.Collection, data map[string]any) *core.Record {
+	t.Helper()
+
+	record := core.NewRecord(collection)
+	for k, v := range data {
+		record.Set(k, v)
+	}
+
+	if err := app.Save(record); err != nil {
+		t.Fatalf("failed to save %s record: %v", collection.Name, err)
+	}
+
+	return record
+}
+
+// sdRawExists reports whether the record row is still physically in the table.
+func sdRawExists(t testing.TB, app core.App, collection *core.Collection, id string) bool {
+	t.Helper()
+
+	var total int
+
+	err := app.DB().Select("count(*)").
+		From(collection.Name).
+		AndWhere(dbx.HashExp{"id": id}).
+		Row(&total)
+	if err != nil {
+		t.Fatalf("failed to count the %s rows: %v", collection.Name, err)
+	}
+
+	return total > 0
+}
+
+func sdFindIds(t testing.TB, records []*core.Record) []string {
+	t.Helper()
+
+	ids := make([]string, len(records))
+	for i, r := range records {
+		ids[i] = r.Id
+	}
+
+	return ids
+}
+
+// -------------------------------------------------------------------
+// collection option and schema
+// -------------------------------------------------------------------
+
+func TestSoftDeleteCollectionSchema(t *testing.T) {
+	app, _ := tests.NewTestApp()
+	defer app.Cleanup()
+
+	posts, _, plain := sdSetup(t, app)
+
+	t.Run("the deleted system field is added", func(t *testing.T) {
+		field := posts.Fields.GetByName(core.FieldNameDeleted)
+		if field == nil {
+			t.Fatal("expected a deleted field to be added")
+		}
+
+		dateField, ok := field.(*core.DateField)
+		if !ok {
+			t.Fatalf("expected a date field, got %T", field)
+		}
+
+		if !dateField.System {
+			t.Fatal("expected the deleted field to be a system one")
+		}
+	})
+
+	t.Run("no deleted field without the option", func(t *testing.T) {
+		if plain.Fields.GetByName(core.FieldNameDeleted) != nil {
+			t.Fatal("expected no deleted field for a regular collection")
+		}
+	})
+
+	t.Run("the deleted column is created", func(t *testing.T) {
+		fresh, err := app.FindCollectionByNameOrId("sd_posts")
+		if err != nil {
+			t.Fatal(err)
+		}
+
+		if !fresh.SoftDelete {
+			t.Fatal("expected the softDelete option to be persisted")
+		}
+
+		record := sdNewRecord(t, app, fresh, map[string]any{"title": "column check"})
+		if !record.GetDateTime(core.FieldNameDeleted).IsZero() {
+			t.Fatal("expected a zero deleted value for a new record")
+		}
+	})
+
+	t.Run("turning the option off removes the field", func(t *testing.T) {
+		posts.SoftDelete = false
+		if err := app.Save(posts); err != nil {
+			t.Fatal(err)
+		}
+
+		if posts.Fields.GetByName(core.FieldNameDeleted) != nil {
+			t.Fatal("expected the deleted field to be removed")
+		}
+
+		// restore for the remaining subtests
+		posts.SoftDelete = true
+		if err := app.Save(posts); err != nil {
+			t.Fatal(err)
+		}
+	})
+}
+
+func TestSoftDeleteCollectionSerialization(t *testing.T) {
+	app, _ := tests.NewTestApp()
+	defer app.Cleanup()
+
+	posts, _, plain := sdSetup(t, app)
+
+	t.Run("regular collections are serialized as before", func(t *testing.T) {
+		raw, err := plain.MarshalJSON()
+		if err != nil {
+			t.Fatal(err)
+		}
+
+		if strings.Contains(string(raw), "softDelete") {
+			t.Fatalf("expected no softDelete key in\n%s", raw)
+		}
+	})
+
