+func TestPropertyListEncodesBinary(t *testing.T) {
+	node := parseYAML(t, `name: com.example.agent
+enabled: true
+disabled: false
+tiny: 7
+small: 300
+medium: 70000
+large: 1099511627776
+negative: -42
+ratio: 0.5
+unicode: "héllo 世界"
+list: [a, 1, [deep]]
+emptyDict: {}
+emptyList: []
+`)
+	encoded := mustEncode(t, "bplist", node)
+	expectBinaryPlistShape(t, encoded)
+
+	back := mustDecode(t, "bplist", encoded)
+	expectScalar(t, entry(t, back, "name"), "!!str", "com.example.agent")
+	expectScalar(t, entry(t, back, "enabled"), "!!bool", "true")
+	expectScalar(t, entry(t, back, "disabled"), "!!bool", "false")
+	expectScalar(t, entry(t, back, "tiny"), "!!int", "7")
+	expectScalar(t, entry(t, back, "small"), "!!int", "300")
+	expectScalar(t, entry(t, back, "medium"), "!!int", "70000")
+	expectScalar(t, entry(t, back, "large"), "!!int", "1099511627776")
+	expectScalar(t, entry(t, back, "negative"), "!!int", "-42")
+	expectFloat(t, entry(t, back, "ratio"), 0.5)
+	expectScalar(t, entry(t, back, "unicode"), "!!str", "héllo 世界")
+
+	list := entry(t, back, "list")
+	expectKind(t, list, yqlib.SequenceNode, 3)
+	expectKind(t, list.Content[2], yqlib.SequenceNode, 1)
+	expectScalar(t, list.Content[2].Content[0], "!!str", "deep")
+
+	expectKind(t, entry(t, back, "emptyDict"), yqlib.MappingNode, 0)
+	expectKind(t, entry(t, back, "emptyList"), yqlib.SequenceNode, 0)
+}
