+func TestPropertyListRejectsBadBinary(t *testing.T) {
+	full := fixture(t, binaryKitchenSink)
+
+	truncatedBody := append([]byte{}, full[:40]...)
+
+	badRoot := append([]byte{}, full...)
+	binary.BigEndian.PutUint64(badRoot[len(badRoot)-16:len(badRoot)-8], 9999)
+
+	badTable := append([]byte{}, full...)
+	binary.BigEndian.PutUint64(badTable[len(badTable)-8:], 999999)
+
+	cases := map[string][]byte{
+		"header only":           []byte("bplist00"),
+		"truncated":             truncatedBody,
+		"root out of range":     badRoot,
+		"offset table past end": badTable,
+	}
+
+	for name, document := range cases {
+		t.Run(name, func(t *testing.T) {
+			if _, err := decodeWith(t, "plist", document); err == nil {
+				t.Error("expected an error, got none")
+			}
+		})
+	}
+}
