+package formats
+
+import (
+	"bytes"
+	"encoding/base64"
+	"encoding/binary"
+	"io"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/mikefarah/yq/v4/pkg/yqlib"
+)
+
+const xmlHeader = `<?xml version="1.0" encoding="UTF-8"?>
+<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
+<plist version="1.0">
+`
+
+const kitchenSinkXML = xmlHeader + `<dict>
+	<key>name</key>
+	<string>com.example.agent</string>
+	<key>enabled</key>
+	<true/>
+	<key>disabled</key>
+	<false/>
+	<key>retries</key>
+	<integer>3</integer>
+	<key>negative</key>
+	<integer>-42</integer>
+	<key>ratio</key>
+	<real>0.5</real>
+	<key>blob</key>
+	<data>aGVsbG8=</data>
+	<key>when</key>
+	<date>2024-01-02T03:04:05Z</date>
+</dict>
+</plist>
+`
+
+// binaryKitchenSink: 260 bytes
+const binaryKitchenSink = "" +
+	"YnBsaXN0MDDcAQIDBAUGBwgJCgsMDQ4PEBESExQVFhcYVGJsb2JYZGlzYWJsZWRXZW5hYmxlZFVsYXJnZVZtZWRpdW1U" +
+	"bmFtZVhuZWdhdGl2ZVVyYXRpb1VzbWFsbFR0aW55V3VuaWNvZGVUd2hlbkVoZWxsbwgJEwAAAQAAAAAAEgABEXBfEBFj" +
+	"b20uZXhhbXBsZS5hZ2VudBP/////////1iM/4AAAAAAAABEBLBAHaABoAOkAbABsAG8AIE4WdUwzQcWh2lKAAAAIISYv" +
+	"Nz1ESVJYXmNrcHZ3eIGGmqOsr7HCAAAAAAAAAQEAAAAAAAAAGQAAAAAAAAAAAAAAAAAAAMs="
+
+// binaryNested: 115 bytes
+const binaryNested = "" +
+	"YnBsaXN0MDDTAQIDBAUGWWVtcHR5RGljdFllbXB0eUxpc3RUbGlzdNCgpQcICQoNUWEQAQmiCwwQAhAD0Q4PUWtRdggP" +
+	"GSMoKSowMjQ1ODo8P0EAAAAAAAABAQAAAAAAAAAQAAAAAAAAAAAAAAAAAAAAQw=="
+
+// binaryLongCount: 244 bytes, twenty entries, so the dictionary size does not
+// fit in the object marker
+const binaryLongCount = "" +
+	"YnBsaXN0MDDfEBQBAgMEBQYHCAkKCwwNDg8QERITFBUWFxgZGhscHR4fICEiIyQlJicoU2swMFNrMDFTazAyU2swM1Nr" +
+	"MDRTazA1U2swNlNrMDdTazA4U2swOVNrMTBTazExU2sxMlNrMTNTazE0U2sxNVNrMTZTazE3U2sxOFNrMTkQABABEAIQ" +
+	"AxAEEAUQBhAHEAgQCRAKEAsQDBANEA4QDxAQEBEQEhATCDM3Oz9DR0tPU1dbX2Nna29zd3t/g4WHiYuNj5GTlZeZm52f" +
+	"oaOlp6kAAAAAAAABAQAAAAAAAAApAAAAAAAAAAAAAAAAAAAAqw=="
+
+func formatByName(t *testing.T, name string) *yqlib.Format {
+	t.Helper()
+	format, err := yqlib.FormatFromString(name)
+	if err != nil {
+		t.Fatalf("format %v is not available: %v", name, err)
+	}
+	return format
+}
+
+func decodeWith(t *testing.T, name string, input []byte) (*yqlib.CandidateNode, error) {
+	t.Helper()
+	decoder := formatByName(t, name).DecoderFactory()
+	if decoder == nil {
+		t.Fatalf("format %v has no decoder", name)
+	}
+	if err := decoder.Init(bytes.NewReader(input)); err != nil {
+		return nil, err
+	}
+	return decoder.Decode()
+}
+
+func mustDecode(t *testing.T, name string, input []byte) *yqlib.CandidateNode {
+	t.Helper()
+	node, err := decodeWith(t, name, input)
+	if err != nil {
+		t.Fatalf("could not decode %v: %v", name, err)
+	}
+	return node
+}
+
+func encodeWith(t *testing.T, name string, node *yqlib.CandidateNode) ([]byte, error) {
+	t.Helper()
+	encoder := formatByName(t, name).GetConfiguredEncoder()
+	if encoder == nil {
+		t.Fatalf("format %v has no encoder", name)
+	}
+	var out bytes.Buffer
+	if err := encoder.Encode(&out, node); err != nil {
+		return nil, err
+	}
+	return out.Bytes(), nil
+}
+
+func mustEncode(t *testing.T, name string, node *yqlib.CandidateNode) []byte {
+	t.Helper()
+	out, err := encodeWith(t, name, node)
+	if err != nil {
+		t.Fatalf("could not encode %v: %v", name, err)
+	}
+	return out
+}
+
+func parseYAML(t *testing.T, document string) *yqlib.CandidateNode {
+	t.Helper()
+	decoder := formatByName(t, "yaml").DecoderFactory()
+	if err := decoder.Init(strings.NewReader(document)); err != nil {
+		t.Fatalf("could not read yaml: %v", err)
+	}
+	node, err := decoder.Decode()
+	if err != nil {
+		t.Fatalf("could not read yaml: %v", err)
+	}
+	return node
+}
+
+func fixture(t *testing.T, encoded string) []byte {
+	t.Helper()
+	raw, err := base64.StdEncoding.DecodeString(encoded)
+	if err != nil {
+		t.Fatalf("bad fixture: %v", err)
+	}
+	return raw
+}
+
+// entry looks a key up in a mapping node.
+func entry(t *testing.T, node *yqlib.CandidateNode, key string) *yqlib.CandidateNode {
+	t.Helper()
+	if node.Kind != yqlib.MappingNode {
+		t.Fatalf("expected a mapping, got kind %v", node.Kind)
+	}
+	for index := 0; index+1 < len(node.Content); index += 2 {
+		if node.Content[index].Value == key {
+			return node.Content[index+1]
+		}
+	}
+	t.Fatalf("mapping has no key %v", key)
+	return nil
+}
+
+func expectScalar(t *testing.T, node *yqlib.CandidateNode, tag string, value string) {
+	t.Helper()
+	if node.Kind != yqlib.ScalarNode {
+		t.Fatalf("expected a scalar, got kind %v", node.Kind)
+	}
+	if node.Tag != tag {
+		t.Errorf("expected tag %v, got %v (value %v)", tag, node.Tag, node.Value)
+	}
+	if node.Value != value {
+		t.Errorf("expected value %v, got %v", value, node.Value)
+	}
+}
+
+// expectFloat compares the number a scalar holds rather than how it was
+// written, so that any exact spelling of the value is accepted.
+func expectFloat(t *testing.T, node *yqlib.CandidateNode, value float64) {
+	t.Helper()
+	if node.Kind != yqlib.ScalarNode {
+		t.Fatalf("expected a scalar, got kind %v", node.Kind)
+	}
+	if node.Tag != "!!float" {
+		t.Errorf("expected tag !!float, got %v (value %v)", node.Tag, node.Value)
+	}
+	got, err := strconv.ParseFloat(node.Value, 64)
+	if err != nil {
+		t.Fatalf("%v is not a number: %v", node.Value, err)
+	}
+	if got != value {
+		t.Errorf("expected %v, got %v", value, got)
+	}
+}
+
+func expectKind(t *testing.T, node *yqlib.CandidateNode, kind yqlib.Kind, children int) {
+	t.Helper()
+	if node.Kind != kind {
+		t.Fatalf("expected kind %v, got %v", kind, node.Kind)
+	}
+	if len(node.Content) != children {
+		t.Fatalf("expected %v children, got %v", children, len(node.Content))
+	}
+}
+
+// expectBinaryPlistShape checks the envelope of a binary property list without
+// assuming any particular object layout.
+func expectBinaryPlistShape(t *testing.T, raw []byte) {
+	t.Helper()
+	if !bytes.HasPrefix(raw, []byte("bplist")) {
+		t.Fatalf("output is not a binary property list, starts with %q", raw[:min(8, len(raw))])
+	}
+	if len(raw) < 40 {
+		t.Fatalf("binary property list is too short: %v bytes", len(raw))
+	}
+
+	trailer := raw[len(raw)-32:]
+	offsetSize := uint64(trailer[6])
+	refSize := uint64(trailer[7])
+	numObjects := binary.BigEndian.Uint64(trailer[8:16])
+	topObject := binary.BigEndian.Uint64(trailer[16:24])
+	offsetTableOffset := binary.BigEndian.Uint64(trailer[24:32])
+
+	if offsetSize < 1 || offsetSize > 8 {
+		t.Errorf("offset size %v is not usable", offsetSize)
+	}
+	if refSize < 1 || refSize > 8 {
+		t.Errorf("object reference size %v is not usable", refSize)
+	}
+	if numObjects == 0 {
+		t.Fatal("binary property list holds no objects")
+	}
+	if topObject >= numObjects {
+		t.Errorf("root object %v is not one of the %v objects", topObject, numObjects)
+	}
+	if offsetTableOffset+numObjects*offsetSize > uint64(len(raw)-32) {
+		t.Errorf("offset table does not fit in the document")
+	}
+}
+
+func min(a int, b int) int {
+	if a < b {
+		return a
+	}
+	return b
+}
+
+func TestPropertyListFormatsAreRegistered(t *testing.T) {
+	for _, name := range []string{"plist", "bplist"} {
+		format := formatByName(t, name)
+		if format.EncoderFactory == nil {
+			t.Errorf("%v cannot be used as an output format", name)
+		}
+		if format.DecoderFactory == nil {
+			t.Errorf("%v cannot be used as an input format", name)
+		}
+	}
+
+	if got := yqlib.FormatStringFromFilename("Info.plist"); got != "plist" {
+		t.Errorf("expected a .plist file to be read as plist, got %v", got)
+	}
+}
+
+// Either name reads either flavour, because a file on disk may hold either.
+func TestPropertyListNamesAcceptEitherFlavour(t *testing.T) {
+	throughBinaryName := mustDecode(t, "bplist", []byte(kitchenSinkXML))
+	expectScalar(t, entry(t, throughBinaryName, "name"), "!!str", "com.example.agent")
+	expectScalar(t, entry(t, throughBinaryName, "retries"), "!!int", "3")
+	expectScalar(t, entry(t, throughBinaryName, "enabled"), "!!bool", "true")
+
+	throughXMLName := mustDecode(t, "plist", fixture(t, binaryKitchenSink))
+	expectScalar(t, entry(t, throughXMLName, "name"), "!!str", "com.example.agent")
+	expectScalar(t, entry(t, throughXMLName, "tiny"), "!!int", "7")
+	expectScalar(t, entry(t, throughXMLName, "unicode"), "!!str", "héllo 世界")
+}
+
+func TestPropertyListDecodesXMLScalars(t *testing.T) {
+	node := mustDecode(t, "plist", []byte(kitchenSinkXML))
+	expectKind(t, node, yqlib.MappingNode, 16)
+
+	expectScalar(t, entry(t, node, "name"), "!!str", "com.example.agent")
+	expectScalar(t, entry(t, node, "enabled"), "!!bool", "true")
+	expectScalar(t, entry(t, node, "disabled"), "!!bool", "false")
+	expectScalar(t, entry(t, node, "retries"), "!!int", "3")
+	expectScalar(t, entry(t, node, "negative"), "!!int", "-42")
+	expectFloat(t, entry(t, node, "ratio"), 0.5)
+	expectScalar(t, entry(t, node, "blob"), "!!binary", "aGVsbG8=")
+	expectScalar(t, entry(t, node, "when"), "!!timestamp", "2024-01-02T03:04:05Z")
+}
+
+func TestPropertyListDecodesXMLContainers(t *testing.T) {
+	document := xmlHeader + `<dict>
+	<key>list</key>
+	<array>
+		<string>a</string>
+		<integer>1</integer>
+		<array>
+			<string>deep</string>
+		</array>
+	</array>
+	<key>emptyDict</key>
+	<dict/>
+	<key>emptyList</key>
+	<array/>
+	<key>nested</key>
+	<dict>
+		<key>inner</key>
+		<string>value</string>
+	</dict>
+</dict>
+</plist>
+`
+	node := mustDecode(t, "plist", []byte(document))
+
+	list := entry(t, node, "list")
+	expectKind(t, list, yqlib.SequenceNode, 3)
+	expectScalar(t, list.Content[0], "!!str", "a")
+	expectScalar(t, list.Content[1], "!!int", "1")
+	expectKind(t, list.Content[2], yqlib.SequenceNode, 1)
+	expectScalar(t, list.Content[2].Content[0], "!!str", "deep")
+
+	expectKind(t, entry(t, node, "emptyDict"), yqlib.MappingNode, 0)
+	expectKind(t, entry(t, node, "emptyList"), yqlib.SequenceNode, 0)
+
+	nested := entry(t, node, "nested")
+	expectKind(t, nested, yqlib.MappingNode, 2)
+	expectScalar(t, entry(t, nested, "inner"), "!!str", "value")
+}
+
+func TestPropertyListDecodesXMLWithoutWrapper(t *testing.T) {
+	node := mustDecode(t, "plist", []byte(`<string>bare</string>`))
+	expectScalar(t, node, "!!str", "bare")
+}
+
+func TestPropertyListDecodesXMLEntities(t *testing.T) {
+	node := mustDecode(t, "plist", []byte(xmlHeader+`<dict>
+	<key>a&amp;b</key>
+	<string>x &lt; y &amp; z</string>
+</dict>
+</plist>
+`))
+	expectScalar(t, entry(t, node, "a&b"), "!!str", "x < y & z")
+}
+
+func TestPropertyListReportsOneDocumentOnly(t *testing.T) {
+	decoder := formatByName(t, "plist").DecoderFactory()
+	if err := decoder.Init(strings.NewReader(kitchenSinkXML)); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := decoder.Decode(); err != nil {
+		t.Fatalf("first read failed: %v", err)
+	}
+	if _, err := decoder.Decode(); err != io.EOF {
+		t.Errorf("expected EOF after the only value, got %v", err)
+	}
+}
