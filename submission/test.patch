+func TestPropertyListEncodesBinaryLargeCollections(t *testing.T) {
+	var builder strings.Builder
+	for index := 0; index < 40; index++ {
+		builder.WriteString("key")
+		builder.WriteString(string(rune('a' + index%26)))
+		builder.WriteString(string(rune('a' + index/26)))
+		builder.WriteString(": ")
+		builder.WriteString(strings.Repeat("v", index+1))
+		builder.WriteString("\n")
+	}
+
+	node := parseYAML(t, builder.String())
+	encoded := mustEncode(t, "bplist", node)
+	expectBinaryPlistShape(t, encoded)
+
+	back := mustDecode(t, "bplist", encoded)
+	expectKind(t, back, yqlib.MappingNode, 80)
+	expectScalar(t, entry(t, back, "keyaa"), "!!str", "v")
+}
