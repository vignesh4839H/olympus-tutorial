+func TestPropertyListRejectsBadXML(t *testing.T) {
+	cases := map[string]string{
+		"value without a key":  xmlHeader + `<dict><string>x</string></dict></plist>`,
+		"key without a value":  xmlHeader + `<dict><key>a</key></dict></plist>`,
