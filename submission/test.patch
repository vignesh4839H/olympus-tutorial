+func TestPropertyListConvertsBetweenFlavours(t *testing.T) {
+	fromBinary := mustDecode(t, "plist", fixture(t, binaryKitchenSink))
+	asXML := mustEncode(t, "plist", fromBinary)
+
+	if !bytes.HasPrefix(asXML, []byte(xmlHeader)) {
+		t.Fatalf("xml output is missing the property list header:\n%v", string(asXML))
+	}
+
+	reread := mustDecode(t, "plist", asXML)
+	expectScalar(t, entry(t, reread, "large"), "!!int", "1099511627776")
+	expectScalar(t, entry(t, reread, "unicode"), "!!str", "héllo 世界")
+	expectScalar(t, entry(t, reread, "when"), "!!timestamp", "2024-01-02T03:04:05Z")
+
+	backToBinary := mustEncode(t, "bplist", reread)
+	expectBinaryPlistShape(t, backToBinary)
+
+	final := mustDecode(t, "plist", backToBinary)
+	expectScalar(t, entry(t, final, "blob"), "!!binary", "aGVsbG8=")
+	expectFloat(t, entry(t, final, "ratio"), 0.5)
+}
