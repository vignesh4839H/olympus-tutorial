+func TestPropertyListEscapesXMLText(t *testing.T) {
+	node := parseYAML(t, `"a<b": "x & y > z"`)
+	encoded := string(mustEncode(t, "plist", node))
+
+	if !strings.Contains(encoded, "<key>a&lt;b</key>") {
+		t.Errorf("key was not escaped: %v", encoded)
+	}
+	if !strings.Contains(encoded, "<string>x &amp; y &gt; z</string>") {
+		t.Errorf("value was not escaped: %v", encoded)
+	}
+}
